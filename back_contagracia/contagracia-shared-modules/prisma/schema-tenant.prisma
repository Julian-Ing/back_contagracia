enum SalaryType {
  ORDINARIO  // Salario ordinario - prestaciones sociales aparte
  INTEGRAL   // Salario integral >= 13 SMLMV - factor prestacional incluido (30%)
}
  
// HR Performance - Observaciones y Evaluaciones
