}

model PhTower {
  id             String   @id @default(uuid())
  condominium_id String
  name           String
  code           String?
  total_floors   Int?
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  condominium PhCondominium @relation(fields: [condominium_id], references: [id], onDelete: Cascade)
  units       PhUnit[]

  @@index([condominium_id])
  @@map("ph_towers")
}

model PhUnitType {
  id              String   @id @default(uuid())
  company_id      String
  name            String
  code            String?
  description     String?
  is_rentable     Boolean  @default(false)
  is_parking      Boolean  @default(false)
  free_minutes    Int?     @default(0)
  rental_fee      Decimal? @db.Decimal(15, 2)
  rental_fee_type String?
  fee_concept_id  String?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  units PhUnit[]

  @@index([company_id])
  @@map("ph_unit_types")
}

model PhUnit {
  id             String   @id @default(uuid())
  condominium_id String
  tower_id       String?
  unit_type_id   String?
  unit_number    String
  floor          Int?
  area_m2        Decimal? @db.Decimal(10, 2)
  coefficient    Decimal? @db.Decimal(10, 6)
  parent_unit_id String?
  is_active      Boolean  @default(true)
  notes          String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  created_by     String?

  condominium PhCondominium  @relation(fields: [condominium_id], references: [id], onDelete: Cascade)
  tower       PhTower?       @relation(fields: [tower_id], references: [id])
  unit_type   PhUnitType?    @relation(fields: [unit_type_id], references: [id])
  parent_unit PhUnit?        @relation("UnitHierarchy", fields: [parent_unit_id], references: [id])
  child_units PhUnit[]       @relation("UnitHierarchy")

  residents    PhUnitResident[]
  vehicles     PhVehicle[]
  fees         PhFee[]
  reservations PhCommonAreaReservation[]
  rentals_as_unit   PhUnitRental[] @relation("RentalUnit")
  rentals_as_renter PhUnitRental[] @relation("RenterUnit")
  maintenance_plans PhMaintenancePlan[]
  access_logs       PhAccessLog[]
  packages          PhPackage[]

  @@index([condominium_id])
  @@index([tower_id])
  @@index([unit_type_id])
  @@map("ph_units")
}

model PhUnitResident {
  id            String    @id @default(uuid())
  unit_id       String
  tercero_id    String
  resident_type String
  is_primary    Boolean   @default(false)
  move_in_date  DateTime?
  move_out_date DateTime?
  is_active     Boolean   @default(true)
  notes         String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  unit PhUnit @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  vehicles PhVehicle[]
  fees     PhFee[]

  @@index([unit_id])
  @@index([tercero_id])
  @@map("ph_unit_residents")
}

model PhVehicle {
  id             String   @id @default(uuid())
  unit_id        String
  resident_id    String?
  vehicle_type   String
  brand          String?
  model          String?
  year           Int?
  color          String?
  plate          String?
  sticker_number String?
  parking_space  String?
  is_active      Boolean  @default(true)
  notes          String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  unit     PhUnit          @relation(fields: [unit_id], references: [id], onDelete: Cascade)
  resident PhUnitResident? @relation(fields: [resident_id], references: [id])

  @@index([unit_id])
  @@map("ph_vehicles")
}

model PhFeeConcept {
  id               String   @id @default(uuid())
  company_id       String
  name             String
  code             String?
  description      String?
  default_amount   Decimal? @db.Decimal(15, 2)
  is_recurring     Boolean  @default(true)
  calculation_type String   @default("fixed")
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  fees                       PhFee[]
  billing_config_associations PhBillingConfigConcept[]

  @@index([company_id])
  @@map("ph_fee_concepts")
}

model PhBillingPeriod {
  id             String    @id @default(uuid())
  condominium_id String
  name           String
  year           Int
  month          Int
  due_date       DateTime?
  notes          String?
  status         String    @default("draft")
  generated_at   DateTime?
  closed_at      DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  created_by     String?

  condominium PhCondominium @relation(fields: [condominium_id], references: [id], onDelete: Cascade)
  fees        PhFee[]

  @@unique([condominium_id, year, month])
  @@index([condominium_id])
  @@map("ph_billing_periods")
}

model PhFee {
  id                String    @id @default(uuid())
  billing_period_id String
  unit_id           String
  fee_concept_id    String
  resident_id       String?
  amount            Decimal   @db.Decimal(15, 2)
  balance           Decimal   @db.Decimal(15, 2)
  status            String    @default("pending")
  due_date          DateTime?
  paid_at           DateTime?
  fee_type          String    @default("regular")
  parent_fee_id     String?
  notes             String?
  email_sent_at     DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  billing_period PhBillingPeriod @relation(fields: [billing_period_id], references: [id], onDelete: Cascade)
  unit           PhUnit          @relation(fields: [unit_id], references: [id])
  fee_concept    PhFeeConcept    @relation(fields: [fee_concept_id], references: [id])
  resident       PhUnitResident? @relation(fields: [resident_id], references: [id])
  parent_fee     PhFee?          @relation("FeeHierarchy", fields: [parent_fee_id], references: [id])
  child_fees     PhFee[]         @relation("FeeHierarchy")
  payments       PhPayment[]

  @@index([billing_period_id])
  @@index([unit_id])
  @@index([fee_concept_id])
  @@map("ph_fees")
}

model PhPayment {
  id             String   @id @default(uuid())
  fee_id         String
  amount         Decimal  @db.Decimal(15, 2)
  payment_date   DateTime @default(now())
  payment_method String?
  reference      String?
  notes          String?
  receipt_url    String?
  created_by     String?
  created_at     DateTime @default(now())

  fee PhFee @relation(fields: [fee_id], references: [id], onDelete: Cascade)

  @@index([fee_id])
  @@map("ph_payments")
}

model PhCommonArea {
  id                String   @id @default(uuid())
  condominium_id    String
  name              String
  description       String?
  capacity          Int?
  rental_fee        Decimal? @db.Decimal(15, 2)
