  @@index([payment_receipt_id])
  @@index([kind])
  @@index([account_code])
  @@index([journal_entry_item_id])
  @@index([company_payment_method_id])
  @@index([cost_center_id])
  @@map("payment_receipt_lines")
}

// ============================================
// PAYMENTS (Pagos individuales)
// ============================================

model Payment {
  id                      String   @id @default(uuid())
  ar_ap_id                String
  consecutive             String? // RP-0001 / PP-0001
  date                    DateTime @db.Date
  amount                  Decimal  @db.Decimal(19, 4)
  description             String?
  is_voided               Boolean  @default(false)
  journal_entry_id        String?
  journal_entry_item_id   String?
  payment_receipt_id      String?
  payment_receipt_line_id String?
