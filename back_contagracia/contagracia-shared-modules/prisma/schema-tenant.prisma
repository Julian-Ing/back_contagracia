model JournalEntryType {
  key         String @id
  description String
  color       String @default("#6B7280")

  journal_entries JournalEntry[]

  @@map("journal_entry_types")
}

model JournalEntry {
  id           String    @id @default(uuid())
  consecutive  String?
  date         DateTime? @db.Date // nullable para asientos de cierre
  description  String?
  type_key     String
  reference_id String?
  is_reversed  Boolean  @default(false)
  created_at   DateTime @default(now())

  // -- Recurrente --
  is_recurrent        Boolean @default(false)
  recurrent_name      String?
  recurrent_period    String? // 1 month, 1 week, etc.
  recurrent_is_active Boolean @default(false)

  type                      JournalEntryType         @relation(fields: [type_key], references: [key])
  items                     JournalEntryItem[]
  accounting_period_actions AccountingPeriodAction[]
  fixed_asset_movements     FixedAssetMovement[]
  payment_receipts          PaymentReceipt[]
  payments                  Payment[]

  @@index([type_key])
  @@index([date])
  @@map("journal_entries")
}

model JournalEntryItem {
  id               String                    @id @default(uuid())
  journal_entry_id String
  account_code     String
  type             JournalEntryItemType
  amount           Decimal                   @db.Decimal(19, 4)
  description      String?
  third_party_id   String?
  bank_account_id  String?
  cost_center_id          String?
  cost_center_movement_id       String?
  cost_center_movement_type_key String?
  reference_type          JournalEntryItemRefType   @default(NORMAL)
  reference_id            String?

  journal_entry             JournalEntry             @relation(fields: [journal_entry_id], references: [id], onDelete: Cascade)
  account                   ChartOfAccount           @relation(fields: [account_code], references: [code])
  third_party               ThirdParty?              @relation(fields: [third_party_id], references: [id])
  bank_account              BankAccount?             @relation(fields: [bank_account_id], references: [id])
  cost_center               CostCenter?              @relation(fields: [cost_center_id], references: [id])
  cost_center_movement      CostCenterMovement?      @relation(fields: [cost_center_movement_id], references: [id])
  cost_center_movement_type CostCenterMovementType?  @relation(fields: [cost_center_movement_type_key], references: [key])
  bank_reconciliation_items BankReconciliationItem[]
  payment_receipt_lines     PaymentReceiptLine[]
  payments                  Payment[]

  @@index([journal_entry_id])
  @@index([account_code])
  @@index([cost_center_id])
  @@index([cost_center_movement_id])
  @@index([reference_type])
  @@index([reference_id])
  @@map("journal_entry_items")
}

// ============================================
// ACCOUNTING PERIODS (Periodos Contables)
// ============================================

model AccountingPeriod {
  id          String @id @default(uuid())
  consecutive String @unique // PC-0001
  name        String // "Enero 2025", "Año 2025"

  start_date DateTime @db.Date
  end_date   DateTime @db.Date
  year       Int

  is_annual        Boolean                @default(false) // TRUE = cierra cuentas 4/5/6
  parent_period_id String? // Período anual padre (para mensuales)
  status           AccountingPeriodStatus @default(OPEN)

  closed_at   DateTime?
  closed_by   String?
  reopened_at DateTime?
  reopened_by String?

  description String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  parent_period    AccountingPeriod?  @relation("PeriodParent", fields: [parent_period_id], references: [id])
  child_periods    AccountingPeriod[] @relation("PeriodParent")
  closed_by_user   TenantUser?        @relation("PeriodClosedBy", fields: [closed_by], references: [id])
  reopened_by_user TenantUser?        @relation("PeriodReopenedBy", fields: [reopened_by], references: [id])

  actions AccountingPeriodAction[]

  @@index([year])
  @@index([status])
  @@index([is_annual])
  @@index([parent_period_id])
  @@map("accounting_periods")
}

model AccountingPeriodAction {
  id        String                     @id @default(uuid())
  period_id String
  action    AccountingPeriodActionType

  reason           String?
  journal_entry_id String?
  created_by       String?
  is_manual        Boolean @default(false)

  created_at DateTime @default(now())

  // Relations
  period          AccountingPeriod @relation(fields: [period_id], references: [id], onDelete: Cascade)
  journal_entry   JournalEntry?    @relation(fields: [journal_entry_id], references: [id])
  created_by_user TenantUser?      @relation("PeriodActionCreatedBy", fields: [created_by], references: [id])

  @@index([period_id])
  @@index([action])
  @@map("accounting_period_actions")
}

model ArApSource {
  key         String @id
  description String

  ar_ap_records         ArAp[]
  payment_receipt_lines PaymentReceiptLine[]
  prepayment_movements  PrepaymentMovement[]

  @@map("ar_ap_sources")
}

model BankAccount {
  id             String          @id @default(uuid())
  bank_id        String?
  account_number String?
  account_type   BankAccountType
  account_name   String
  account_id     String? // FK a ChartOfAccount

  initial_balance Decimal @default(0) @db.Decimal(15, 4)
  current_balance Decimal @default(0) @db.Decimal(15, 4)

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  bank                   Bank?                 @relation(fields: [bank_id], references: [id])
  journal_entry_items    JournalEntryItem[]
  reconciliations        BankReconciliation[]
  cash_registers         CashRegister[]        @relation("CashRegisterCashAccount")
  document_payments DocumentPayment[]
  bank_movements    BankMovement[]
  prepayments            Prepayment[]

  @@index([bank_id])
  @@map("bank_accounts")
