enum DocType {
  INVOICE // Factura de venta
  INVOICE_CREDIT_NOTE // Nota crédito venta
  INVOICE_DEBIT_NOTE // Nota débito venta
  INVOICE_POS // Factura POS
  INVOICE_RECURRENT // Factura recurrente
  PURCHASE // Compra
