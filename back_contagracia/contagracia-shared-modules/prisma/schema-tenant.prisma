  @@index([third_party_id])
  @@index([source_key])
  @@index([account_code])
  @@index([type])
  @@index([status])
  @@index([date])
  @@map("ar_ap")
}

// ============================================
// PAYMENT RECEIPTS (Recibos de Caja / Comprobantes de Egreso)
// ============================================

model PaymentReceipt {
  id               String               @id @default(uuid())
  type             PaymentReceiptType
  consecutive      String? // RC-0001 / CE-0001
  date             DateTime             @db.Date
  amount           Decimal              @db.Decimal(19, 4)
  third_party_id   String?
  journal_entry_id String?
  status           PaymentReceiptStatus @default(ACTIVE)
