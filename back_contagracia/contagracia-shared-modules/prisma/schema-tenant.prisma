model ArlRisk {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  rate       Decimal  @db.Decimal(8, 4)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  third_parties     ThirdParty[]

  @@map("arl_risk")
}

// ============================================
// THIRD PARTIES (Entidad unificada)
// Un third party puede ser: Cliente, Proveedor, Empleado, EPS, ARL, etc.
// Un mismo third party puede tener múltiples roles
// ============================================

model ThirdParty {
  id String @id @default(uuid())

  // ========== IDENTIFICACIÓN ==========
  name                  String?
  identification_number String?
  dv                    String?

  // FKs a tablas paramétricas
  type_document_identification_id String?
  type_organization_id            String?
  type_regime_id                  String?
  type_liability_id               String?
  department_id                   String?
  municipality_id                 String?

  // ========== CONTACTO ==========
  email   String?
  phone   String?
  address String?

  // ========== ROLES ==========
  roles ThirdPartyType[]

  // ========== PERSONA NATURAL ==========
  first_name     String?
  second_name    String?
  first_surname  String?
  second_surname String?

  // ========== TAX INFO ==========
  codigo_pila String?

  // ========== VINCULACIÓN USUARIO ==========
  // La relación es inversa: TenantUser.third_party_id -> ThirdParty.id
  // Ver relación tenant_user abajo

  // ========== CUENTAS CONTABLES ==========
  cxc_account_code String?
  cxp_account_code String?

  // ========== DATOS DE EMPLEADO (solo si roles incluye EMPLOYEE) ==========
  // Datos laborales
  hire_date         DateTime?
  payment_method_id String?
  arl_risk_class_id String?

  // Seguridad social (FKs a otros ThirdParty tipo EPS, ARL, etc.)
  eps_id               String?
  pension_fund_id      String?
  arl_id               String?
  compensation_fund_id String?
  severance_fund_id    String?

  // Datos bancarios del empleado
  bank_name           String?
  bank_account_type   BankAccountType?
  bank_account_number String?

  // Centro de costos
  cost_center_id String?

  // Comisión
  commission_rate Decimal? @db.Decimal(8, 4)

  // Director/Supervisor
  director_id String?

  // Flags de empleado
  is_administrative Boolean         @default(false)
  employee_status   EmployeeStatus?

  // Referencias al registro actual de contrato y salario (solo EMPLOYEE)
  current_contract_id String? @unique
  current_salary_id   String? @unique

  // ========== DATOS CRM (solo si roles incluye CONTACT) ==========
  company_name             String?
  whatsapp_number          String?   @unique
  whatsapp_subscribed      Boolean   @default(false)
  last_whatsapp_message_at DateTime?
  crm_tags                 String[]
  notes                    String?   @db.Text
  birth_date               DateTime? @db.Date
  segment                  String?

  // GDPR / Consentimiento
  consent_ip        String?
  consent_timestamp DateTime?
  consent_method    String?

  // ========== ESTADO Y TIMESTAMPS ==========
  is_active  Boolean   @default(true)
  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  // Auditoría
  created_by String?
  updated_by String?

  // ========== RELATIONS ==========
  // Usuario del sistema (si tiene acceso)
  tenant_user TenantUser?

  // Paramétricas
  type_document_identification TypeDocumentIdentification? @relation(fields: [type_document_identification_id], references: [id])
  type_organization            TypeOrganization?           @relation(fields: [type_organization_id], references: [id])
  type_regime                  TypeRegime?                 @relation(fields: [type_regime_id], references: [id])
  type_liability               TypeLiability?              @relation(fields: [type_liability_id], references: [id])
  department                   Department?                 @relation(fields: [department_id], references: [id])
  municipality                 Municipality?               @relation(fields: [municipality_id], references: [id])

  // Paramétricas de empleado
  payment_method PaymentMethod? @relation("ThirdPartyPaymentMethod", fields: [payment_method_id], references: [id])
  arl_risk_class ArlRisk?       @relation(fields: [arl_risk_class_id], references: [id])

  // Cuentas contables
  cxc_account ChartOfAccount? @relation("ThirdPartyCxcAccount", fields: [cxc_account_code], references: [code])
  cxp_account ChartOfAccount? @relation("ThirdPartyCxpAccount", fields: [cxp_account_code], references: [code])
  cost_center CostCenter?     @relation(fields: [cost_center_id], references: [id])

  // Seguridad social (self-relations a otros third parties)
  eps               ThirdParty? @relation("ThirdPartyEps", fields: [eps_id], references: [id])
  pension_fund      ThirdParty? @relation("ThirdPartyPension", fields: [pension_fund_id], references: [id])
  arl               ThirdParty? @relation("ThirdPartyArl", fields: [arl_id], references: [id])
  compensation_fund ThirdParty? @relation("ThirdPartyCompensation", fields: [compensation_fund_id], references: [id])
  severance_fund    ThirdParty? @relation("ThirdPartySeverance", fields: [severance_fund_id], references: [id])

  // Empleados que usan este third party como EPS, ARL, etc.
  employees_eps          ThirdParty[] @relation("ThirdPartyEps")
  employees_pension      ThirdParty[] @relation("ThirdPartyPension")
  employees_arl          ThirdParty[] @relation("ThirdPartyArl")
  employees_compensation ThirdParty[] @relation("ThirdPartyCompensation")
  employees_severance    ThirdParty[] @relation("ThirdPartySeverance")

  // Jerarquía de empleados
  director     ThirdParty?  @relation("ThirdPartyDirector", fields: [director_id], references: [id])
  subordinates ThirdParty[] @relation("ThirdPartyDirector")

  // AR/AP, Payments, Prepayments
  ar_ap_records       ArAp[]
  payment_receipts    PaymentReceipt[]
  prepayments         Prepayment[]
  journal_entry_items JournalEntryItem[]

  // CRM (solo si roles incluye CONTACT)
  crm_leads                  CrmLead[]                 @relation("CrmLeadContact")
  crm_activities             CrmActivity[]             @relation("CrmActivityContact")
  crm_opportunities          CrmOpportunity[]          @relation("CrmOpportunityContact")
  crm_form_submissions       CrmFormSubmission[]       @relation("CrmFormSubmissionContact")
  crm_email_sends            EmailSend[]               @relation("CrmEmailSendContact")
  crm_whatsapp_conversations CrmWhatsappConversation[] @relation("CrmWhatsappConversationContact")
  crm_whatsapp_messages      CrmWhatsappMessage[]      @relation("CrmWhatsappMessageContact")
  crm_tag_assignments        CrmContactTagAssignment[] @relation("CrmTagAssignmentContact")
  crm_documents              Document[]                @relation("ContactDocuments")

  // Auditoría
  created_by_user TenantUser? @relation("ThirdPartyCreatedBy", fields: [created_by], references: [id])
  updated_by_user TenantUser? @relation("ThirdPartyUpdatedBy", fields: [updated_by], references: [id])

  // PH - Pólizas de seguro (SUPPLIER = aseguradora)
  insurance_policies         PhInsurancePolicy[]         @relation("InsurancePolicyThirdParty")
  insurance_policy_insurers  PhInsurancePolicyInsurer[]   @relation("InsurancePolicyInsurerThirdParty")

  // PH - Planes de mantenimiento (SUPPLIER = proveedor mantenimiento)
  maintenance_plans          PhMaintenancePlan[]          @relation("MaintenancePlanProvider")
  maintenance_logs           PhMaintenanceLog[]           @relation("MaintenanceLogProvider")

  // POS
  cash_movements CashMovement[]

  // HR - Contratos, Salarios y registros directos (solo EMPLOYEE)
  current_contract           EmployeeContract?        @relation("CurrentContract", fields: [current_contract_id], references: [id])
  current_salary             SalaryHistory?            @relation("CurrentSalary", fields: [current_salary_id], references: [id])
  contracts                  EmployeeContract[]        @relation("ThirdPartyContracts")
  salary_history             SalaryHistory[]           @relation("ThirdPartySalaries")
  attendance_records         AttendanceRecord[]        @relation("ThirdPartyAttendance")
  overtime_records_employee  OvertimeRecord[]          @relation("ThirdPartyOvertime")
  overtime_approvals         OvertimeRecord[]          @relation("OvertimeApprover")
  leave_requests_employee    LeaveRequest[]            @relation("ThirdPartyLeaves")
  leave_approvals            LeaveRequest[]            @relation("LeaveApprover")
  travel_expenses            EmployeeTravelExpense[]   @relation("ThirdPartyTravelExpenses")
  travel_expense_approvals   EmployeeTravelExpense[]   @relation("TravelExpenseApprover")
  payroll_details            PayrollSettlementDetail[] @relation("ThirdPartyPayrollDetails")
  employee_observations      EmployeeObservation[]     @relation("ThirdPartyObservations")
  performance_evaluations    PerformanceEvaluation[]   @relation("ThirdPartyEvaluations")

  // HR - Turnos (solo EMPLOYEE)
  shift_assignments          ShiftAssignment[]         @relation("ThirdPartyShiftAssignments")
  shift_swap_requests        ShiftSwapRequest[]        @relation("ShiftSwapRequester")
  shift_swap_targets         ShiftSwapRequest[]        @relation("ShiftSwapTarget")

  @@index([type_document_identification_id])
  @@index([type_organization_id])
  @@index([department_id])
  @@index([municipality_id])
  @@index([roles])
  @@index([employee_status])
  @@index([cost_center_id])
  @@index([segment])
  @@index([whatsapp_number])
  @@index([created_by])
  @@index([updated_by])
  @@map("third_parties")
}

// ============================================
// EMPLOYEE CONTRACTS & SALARY HISTORY
// Historial de contratos y salarios vinculados a ThirdParty (rol EMPLOYEE)
// ============================================

model EmployeeContract {
  id              String    @id @default(uuid())
  third_party_id  String
  contract_number String?   // CTR-001
  contract_type_id    String?
  worker_type_id      String?
  worker_subtype_id   String?
  position            String?   // Cargo/función del empleado
  probation_days      Int?      // Días de periodo de prueba (0 = sin prueba, null = no definido)
  includes_transport  Boolean   @default(true) // Contrato estipula pago de auxilio de transporte
  start_date          DateTime  @db.Date
  end_date            DateTime? @db.Date // null = indefinido
  is_current          Boolean   @default(true)
  termination_type    TerminationType? // Tipo de terminación (solo al cerrar contrato)
  termination_reason  String?
  observations        String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relaciones
  third_party    ThirdParty    @relation("ThirdPartyContracts", fields: [third_party_id], references: [id], onDelete: Cascade)
  contract_type  TypeContract? @relation("ContractTypeContract", fields: [contract_type_id], references: [id])
  worker_type    TypeWorker?   @relation("ContractWorkerType", fields: [worker_type_id], references: [id])
  worker_subtype SubTypeWorker? @relation("ContractWorkerSubtype", fields: [worker_subtype_id], references: [id])
  salary_history SalaryHistory[] @relation("ContractSalaries")

  // Relación inversa para current_contract_id
  current_for ThirdParty? @relation("CurrentContract")

  @@index([third_party_id])
  @@index([is_current])
  @@map("employee_contracts")
}

model SalaryHistory {
  id                       String      @id @default(uuid())
  third_party_id           String
  contract_id              String?     // FK al contrato bajo el cual aplica este salario
  salary                   Decimal     @db.Decimal(15, 4) // Salario mensual total
  salary_type              SalaryType  @default(ORDINARIO)
  transportation_allowance Decimal?    @db.Decimal(15, 4) // Monto real del auxilio (ej: 200000), null = no aplica
  variable_salary          Boolean     @default(false) // Si tiene componente variable (comisiones)
  effective_date           DateTime    @db.Date
  end_date                 DateTime?   @db.Date // null = vigente
  is_current               Boolean     @default(true)
  reason                   String? // "Ingreso", "Aumento anual", "Promoción"

  created_at DateTime @default(now())

  // Relaciones
  third_party ThirdParty        @relation("ThirdPartySalaries", fields: [third_party_id], references: [id], onDelete: Cascade)
  contract    EmployeeContract? @relation("ContractSalaries", fields: [contract_id], references: [id])

  // Relación inversa para current_salary_id
  current_for ThirdParty? @relation("CurrentSalary")

  @@index([third_party_id])
  @@index([contract_id])
  @@index([is_current])
  @@map("salary_history")
}

// ============================================
// TIME & ATTENDANCE
// ============================================

model AttendanceRecord {
  id              String    @id @default(uuid())
  third_party_id  String
  date            DateTime  @db.Date
  check_in        DateTime?
  check_out       DateTime?
  worked_hours    Decimal?  @db.Decimal(5, 2)
  notes           String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relaciones
  third_party ThirdParty @relation("ThirdPartyAttendance", fields: [third_party_id], references: [id], onDelete: Cascade)

  @@unique([third_party_id, date])
  @@index([date])
  @@map("attendance_records")
}

model OvertimeRecord {
  id              String         @id @default(uuid())
  third_party_id  String
  overtime_date       DateTime       @db.Date
  start_time          String         // HH:mm formato
  end_time            String         // HH:mm formato
  total_hours         Decimal        @db.Decimal(5, 2)
  overtime_type       OvertimeType
  payroll_code        String         // "HEDs", "HENs", etc.
  surcharge_pct       Decimal        @db.Decimal(5, 2) // 25.00, 75.00, etc.
  base_hourly_rate    Decimal?       @db.Decimal(15, 4)
  calculated_amount   Decimal?       @db.Decimal(15, 4)
  reason              String
  notes               String?
  status              OvertimeStatus @default(REQUESTED)
  approved_by_id      String?
  approved_at         DateTime?
  rejection_reason    String?
  cost_center_id      String?
  is_paid             Boolean        @default(false)
  paid_at             DateTime?
  created_by_id       String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relaciones
  third_party  ThirdParty   @relation("ThirdPartyOvertime", fields: [third_party_id], references: [id], onDelete: Cascade)
  approved_by  ThirdParty?  @relation("OvertimeApprover", fields: [approved_by_id], references: [id])
  cost_center  CostCenter?  @relation("OvertimeCostCenter", fields: [cost_center_id], references: [id])

  @@index([third_party_id])
  @@index([overtime_date])
  @@index([status])
  @@map("overtime_records")
}

// ============================================
// LEAVES / VACACIONES Y AUSENCIAS
// ============================================

model LeaveRequest {
  id              String      @id @default(uuid())
  third_party_id  String
  leave_type      LeaveType
  start_date      DateTime    @db.Date
  end_date        DateTime    @db.Date
  days_requested  Int
  reason          String?
  status          LeaveStatus @default(PENDING)
  approved_by_id  String?
  approved_at     DateTime?
  rejection_reason String?
  admin_notes     String?
  source          String      @default("internal") // "internal" | "public"
  created_by_id   String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relaciones
  third_party  ThirdParty   @relation("ThirdPartyLeaves", fields: [third_party_id], references: [id], onDelete: Cascade)
  approved_by  ThirdParty?  @relation("LeaveApprover", fields: [approved_by_id], references: [id])

  @@index([third_party_id])
  @@index([status])
  @@index([start_date, end_date])
  @@index([leave_type])
  @@map("leave_requests")
}

// ============================================
// EMPLOYEE TRAVEL EXPENSES (VIATICOS)
// ============================================

model EmployeeTravelExpense {
  id                String                @id @default(uuid())
  third_party_id    String
  expense_code      String?               // VIA-0001
  expense_category  TravelExpenseCategory @default(BUSINESS_TRIP)
  travel_purpose    String
  destination       String
  start_date        DateTime              @db.Date
  end_date          DateTime              @db.Date
  assigned_amount   Decimal               @db.Decimal(19, 4)
  reported_amount   Decimal?              @db.Decimal(19, 4)
  amount_difference Decimal?              @db.Decimal(19, 4)
  status            TravelExpenseStatus   @default(PENDING)
  approved_by_id    String?
  approved_at       DateTime?
  rejection_reason  String?
  admin_notes       String?
  notes             String?
  reported_at       DateTime?
  created_by_id     String?
  cost_center_id    String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relaciones
  third_party  ThirdParty   @relation("ThirdPartyTravelExpenses", fields: [third_party_id], references: [id], onDelete: Cascade)
  approved_by  ThirdParty?  @relation("TravelExpenseApprover", fields: [approved_by_id], references: [id])
  cost_center  CostCenter?  @relation("TravelExpenseCostCenter", fields: [cost_center_id], references: [id])

  @@index([third_party_id])
  @@index([status])
  @@index([start_date, end_date])
  @@index([expense_category])
  @@map("employee_travel_expenses")
}

// ============================================
// HR PERFORMANCE - Observaciones y Evaluaciones
// ============================================

model EmployeeObservation {
  id               String              @id @default(uuid())
  third_party_id   String
  title            String
  description      String
  observation_date DateTime            @db.Date
  observation_type ObservationType
  severity         ObservationSeverity @default(MEDIUM)
  status           ObservationStatus   @default(ACTIVE)
  action_required  String?
  follow_up_date   DateTime?           @db.Date
  created_by_id    String              // FK → TenantUser.id (quien registra)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relaciones
  third_party ThirdParty @relation("ThirdPartyObservations", fields: [third_party_id], references: [id], onDelete: Cascade)
  created_by  TenantUser @relation("ObservationCreator", fields: [created_by_id], references: [id])

  @@index([third_party_id])
  @@index([observation_type])
  @@index([status])
  @@index([observation_date])
  @@index([created_by_id])
  @@map("employee_observations")
}

model PerformanceEvaluation {
  id                    String           @id @default(uuid())
  third_party_id        String
  evaluation_period     String           // "2026-Q1", "2026-01", etc.
  evaluation_date       DateTime         @db.Date
  status                EvaluationStatus @default(DRAFT)

  // Scores individuales (1-5 entero)
  attendance_score      Int?
  performance_score     Int?
  attitude_score        Int?

  // Score general (promedio ponderado, Decimal para precisión)
  overall_score         Decimal?         @db.Decimal(3, 2)

  // Campos narrativos
  strengths               String?
  areas_for_improvement   String?
  goals_next_period       String?
  evaluator_comments      String?
  employee_comments       String?

  evaluator_id String // FK → TenantUser.id (quien evalúa)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relaciones
  third_party ThirdParty @relation("ThirdPartyEvaluations", fields: [third_party_id], references: [id], onDelete: Cascade)
  evaluator   TenantUser @relation("EvaluationEvaluator", fields: [evaluator_id], references: [id])

  @@index([third_party_id])
  @@index([evaluation_period])
  @@index([status])
  @@index([evaluator_id])
  @@map("performance_evaluations")
}

// ============================================
// SHIFT MANAGEMENT
// Gestión de turnos, horarios y rotaciones
// ============================================

model ShiftTemplate {
  id          String    @id @default(uuid())
  name        String    // "Turno Mañana", "Turno Noche", etc.
  code        String?   // "TM-01"
  shift_type  ShiftType @default(CUSTOM)
  start_time  String    // HH:mm formato 24h (ej: "06:00")
  end_time    String    // HH:mm formato 24h (ej: "14:00")
  break_start String?   // HH:mm inicio del descanso (ej: "10:00")
  break_end   String?   // HH:mm fin del descanso (ej: "10:30")
  break_minutes Int     @default(0) // Minutos totales de descanso
  total_hours Decimal   @db.Decimal(4, 2) // Horas netas de trabajo
  color       String?   // Hex color para UI (ej: "#3B82F6")
  description String?
  is_overnight Boolean  @default(false) // Turno cruza medianoche
  is_active   Boolean   @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relaciones
  assignments         ShiftAssignment[]
  rotation_details    ShiftRotationDetail[]

  @@map("shift_templates")
}

model ShiftSchedule {
  id            String      @id @default(uuid())
  name          String      // "Programación Febrero 2026"
  period_start  DateTime    @db.Date // Inicio del periodo
  period_end    DateTime    @db.Date // Fin del periodo
  status        ShiftStatus @default(DRAFT)
  notes         String?
  published_at  DateTime?
  published_by  String?     // TenantUser id

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relaciones
  publisher   TenantUser?      @relation("ShiftSchedulePublisher", fields: [published_by], references: [id])
  assignments ShiftAssignment[]

  @@index([status])
  @@index([period_start, period_end])
  @@map("shift_schedules")
}

model ShiftAssignment {
  id                String                @id @default(uuid())
  third_party_id    String                // Empleado asignado
  shift_template_id String                // Plantilla de turno
  schedule_id       String?               // Programación a la que pertenece (opcional)
  date              DateTime              @db.Date // Fecha del turno
  custom_start_time String?               // Override hora inicio (si difiere de plantilla)
  custom_end_time   String?               // Override hora fin
  status            ShiftAssignmentStatus @default(ASSIGNED)
  notes             String?
  assigned_by       String?               // TenantUser que asignó

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relaciones
  third_party    ThirdParty    @relation("ThirdPartyShiftAssignments", fields: [third_party_id], references: [id], onDelete: Cascade)
  shift_template ShiftTemplate @relation(fields: [shift_template_id], references: [id])
  schedule       ShiftSchedule? @relation(fields: [schedule_id], references: [id], onDelete: SetNull)
  assigner       TenantUser?   @relation("ShiftAssignmentAssigner", fields: [assigned_by], references: [id])

  // Solicitudes de intercambio donde este turno es el ofrecido
  swap_requests_as_requester ShiftSwapRequest[] @relation("SwapRequesterAssignment")
  swap_requests_as_target    ShiftSwapRequest[] @relation("SwapTargetAssignment")

  @@unique([third_party_id, date]) // Un empleado = un turno por día
  @@index([shift_template_id])
  @@index([schedule_id])
  @@index([date])
  @@index([status])
  @@map("shift_assignments")
}

model ShiftSwapRequest {
  id                      String          @id @default(uuid())
  requester_id            String          // Empleado que solicita el cambio
  target_id               String          // Empleado con quien quiere intercambiar
  requester_assignment_id String          // Turno del solicitante
  target_assignment_id    String          // Turno objetivo
  reason                  String?
  status                  ShiftSwapStatus @default(PENDING)
  approved_by             String?         // TenantUser que aprobó/rechazó
  approved_at             DateTime?
  rejection_reason        String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relaciones
  requester            ThirdParty      @relation("ShiftSwapRequester", fields: [requester_id], references: [id], onDelete: Cascade)
  target               ThirdParty      @relation("ShiftSwapTarget", fields: [target_id], references: [id], onDelete: Cascade)
  requester_assignment ShiftAssignment @relation("SwapRequesterAssignment", fields: [requester_assignment_id], references: [id])
  target_assignment    ShiftAssignment @relation("SwapTargetAssignment", fields: [target_assignment_id], references: [id])
  approver             TenantUser?     @relation("ShiftSwapApprover", fields: [approved_by], references: [id])

  @@index([requester_id])
  @@index([target_id])
  @@index([status])
  @@map("shift_swap_requests")
}

model ShiftRotationPattern {
  id          String              @id @default(uuid())
  name        String              // "Rotación Semanal Día/Noche"
  description String?
  pattern_type RotationPatternType @default(WEEKLY)
  cycle_days  Int                 @default(7) // Días del ciclo
  is_active   Boolean             @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relaciones
  details ShiftRotationDetail[]

  @@map("shift_rotation_patterns")
}

model ShiftRotationDetail {
  id                  String @id @default(uuid())
  rotation_pattern_id String
  day_in_cycle        Int    // Día dentro del ciclo (1, 2, 3...)
  shift_template_id   String // Qué turno aplica ese día
  is_rest_day         Boolean @default(false) // Es día de descanso

  // Relaciones
  rotation_pattern ShiftRotationPattern @relation(fields: [rotation_pattern_id], references: [id], onDelete: Cascade)
  shift_template   ShiftTemplate        @relation(fields: [shift_template_id], references: [id])

  @@unique([rotation_pattern_id, day_in_cycle])
  @@map("shift_rotation_details")
}

// ============================================
// COST CENTERS (recursive hierarchy)
// ============================================

model CostCenter {
  id          String  @id @default(uuid())
  parent_id   String? // Self-reference: null = root, set = child
  consecutive String  @unique // CCT-0001
  name        String
  description String?

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Self-relation (recursive tree)
  parent   CostCenter?  @relation("CostCenterTree", fields: [parent_id], references: [id], onDelete: Cascade)
  children CostCenter[] @relation("CostCenterTree")

  // Projections, movements & accounting
  projections            Projection[]
  movements              CostCenterMovement[]
  journal_entry_items    JournalEntryItem[]
  payment_receipt_lines  PaymentReceiptLine[]
  prepayments            Prepayment[]

  // External relations
  crm_opportunities   CrmOpportunity[]          @relation("CrmOpportunityCostCenter")
  third_parties       ThirdParty[]
  documents              Document[]             @relation("DocumentCostCenter")
  document_items         DocumentItem[]
  document_payments      DocumentPayment[]
  document_withholdings  DocumentWithholding[]
  cash_registers         CashRegister[]
  overtime_records    OvertimeRecord[]           @relation("OvertimeCostCenter")
  travel_expenses     EmployeeTravelExpense[]    @relation("TravelExpenseCostCenter")

  @@index([parent_id])
  @@map("cost_centers")
}

// ============================================
// COST CENTER MOVEMENT CATALOGS
// ============================================

model CostCenterMovementType {
  key    String                    @id // income, cost, expense, tax_iva, withholding_income, etc.
  name   String                   // Ingreso, Costo, Gasto, IVA, ReteFuente, etc.
  nature JournalEntryItemType     @default(DEBIT) // DEBIT o CREDIT — naturaleza del tipo para determinar sign del movimiento

  movements             CostCenterMovement[]
  projection_items      ProjectionItem[]
  payment_receipt_lines PaymentReceiptLine[]
  journal_entry_items   JournalEntryItem[]

  @@map("cost_center_movement_types")
}

model CostCenterMovementReferenceType {
  key  String @id // invoice, purchase, expense, journal_entry, prepayment, etc.
  name String // Factura de Venta, Compra, Gasto, Asiento Contable, Anticipo, etc.

  movements CostCenterMovement[]

  @@map("cost_center_movement_reference_types")
}

// ============================================
// COST CENTER MOVEMENTS
// ============================================

enum CostCenterMovementSign {
  POSITIVE
  NEGATIVE
}

model CostCenterMovement {
  id                 String                 @id @default(uuid())
  cost_center_id     String
  movement_date      DateTime               @db.Date
  type_key           String
  reference_type_key String
  sign               CostCenterMovementSign
  amount             Decimal                @db.Decimal(19, 4)
  description        String?
  reference_id       String?

  created_at DateTime @default(now())

  cost_center    CostCenter                       @relation(fields: [cost_center_id], references: [id], onDelete: Cascade)
  type           CostCenterMovementType           @relation(fields: [type_key], references: [key])
  reference_type CostCenterMovementReferenceType @relation(fields: [reference_type_key], references: [key])
  journal_entry_items JournalEntryItem[]

  @@index([cost_center_id])
  @@index([movement_date])
  @@index([type_key])
  @@index([reference_type_key])
  @@map("cost_center_movements")
}

// ============================================
// PROJECTIONS (recursive: parent/children + items by type)
// ============================================

enum ProjectionScope {
  GLOBAL      // Company-wide
  COST_CENTER // Specific cost center
}

model Projection {
  id              String          @id @default(uuid())
  parent_id       String?         // null = root projection, set = sub-period
  cost_center_id  String?         // null = GLOBAL, set = per cost center
  scope           ProjectionScope
  consecutive     String          @unique // PRJ-0001
  name            String
  description     String?
  start_date          DateTime        @db.Date
  end_date            DateTime        @db.Date
  include_sub_centers Boolean         @default(false) // only for COST_CENTER scope

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Self-relation (recursive: annual → monthly → weekly → ...)
  parent   Projection?  @relation("ProjectionTree", fields: [parent_id], references: [id], onDelete: Cascade)
  children Projection[] @relation("ProjectionTree")

  cost_center CostCenter?      @relation(fields: [cost_center_id], references: [id], onDelete: Cascade)
  items       ProjectionItem[]

  @@index([parent_id])
  @@index([cost_center_id])
  @@index([scope])
  @@map("projections")
}

model ProjectionItem {
  id            String  @id @default(uuid())
  projection_id String
  type_key      String  // FK a CostCenterMovementType
  amount        Decimal @default(0) @db.Decimal(18, 2)

  projection Projection             @relation(fields: [projection_id], references: [id], onDelete: Cascade)
  type       CostCenterMovementType @relation(fields: [type_key], references: [key])

  @@unique([projection_id, type_key])
  @@index([projection_id])
  @@map("projection_items")
}

// ============================================
// INVENTORY
// ============================================

model ProductCategory {
  id          String  @id @default(uuid())
  consecutive String  @unique // CAT-0001
  name        String
  description String?
  is_aiu      Boolean @default(false) // Categoría AIU (facturación)
  is_bag      Boolean @default(false)

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  products Product[]

  @@index([is_active])
  @@map("product_categories")
}

model Product {
  id          String  @id @default(uuid())
  consecutive String  @unique // ART-0001
  barcode     String  @unique
  name        String
  description String?

  // Categoría
  category_id String?

  // Precios
  cost         Decimal     @default(0) @db.Decimal(15, 4)
  price        Decimal     @db.Decimal(15, 4)
  tax_included Boolean     @default(false)
  costing_type CostingType @default(LAST_PURCHASE)

  // Stock
  stock      Decimal @default(0) @db.Decimal(15, 4)
  is_service Boolean @default(false)

  // Combinaciones
  mode              ProductMode @default(PRODUCT)
  parent_product_id String?

  // FKs a paramétricas
  tax_id  String?
  unit_id String? @default("70")

  // Cuentas contables (FK a ChartOfAccount.code)
  asset_account_code   String? // Cuenta de inventario
  cogs_account_code    String? // Cuenta costo de ventas
  revenue_account_code String? // Cuenta de ingresos

  // AIU
  is_aiu Boolean @default(false)
  is_bag Boolean @default(false)

  // Imagen
  image_path String?

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  category        ProductCategory? @relation(fields: [category_id], references: [id])
  tax             Tax?             @relation(fields: [tax_id], references: [id])
  unit            ProductUnit?     @relation(fields: [unit_id], references: [id])
  parent_product  Product?         @relation("ProductCombinations", fields: [parent_product_id], references: [id])
  combinations    Product[]        @relation("ProductCombinations")
  asset_account   ChartOfAccount?  @relation("ProductAssetAccount", fields: [asset_account_code], references: [code])
  cogs_account    ChartOfAccount?  @relation("ProductCogsAccount", fields: [cogs_account_code], references: [code])
  revenue_account ChartOfAccount?  @relation("ProductRevenueAccount", fields: [revenue_account_code], references: [code])

  // Atributos asignados al producto padre (qué atributos aplican)
  attribute_assignments ProductAttributeAssignment[]

  // Opciones de atributo asignadas a esta combinación
  combination_attributes ProductCombinationAttribute[]

  // Stock por bodega
  storage_stocks StorageStock[]

  // Movimientos
  movements ProductMovement[]

  // Items de transferencia entre bodegas
  storage_transfer_items StorageTransferItem[]

  // Items de transferencia entre productos
  product_transfer_items ProductTransferItem[]

  @@index([category_id])
  @@index([tax_id])
  @@index([unit_id])
  @@index([parent_product_id])
  @@index([mode])
  @@index([is_active])
  @@index([is_service])
  @@map("products")
}

// Atributos de producto (Talla, Color, etc.)
model ProductAttribute {
  id          String  @id @default(uuid())
  consecutive String  @unique // ATR-0001
  name        String
  description String?

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  options ProductAttributeOption[]

  // Productos que tienen asignado este atributo
  product_assignments ProductAttributeAssignment[]

  @@index([is_active])
  @@map("product_attributes")
}

// Opciones de atributo (S, M, L, Rojo, Azul, etc.)
model ProductAttributeOption {
  id                   String @id @default(uuid())
  product_attribute_id String
  consecutive          String @unique // OPC-0001
  name                 String

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  attribute              ProductAttribute             @relation(fields: [product_attribute_id], references: [id])
  combination_attributes ProductCombinationAttribute[]

  @@index([product_attribute_id])
  @@index([is_active])
  @@map("product_attribute_options")
}

// Junction: Atributos asignados a un producto padre (qué atributos aplican para sus combinaciones)
model ProductAttributeAssignment {
  id                   String @id @default(uuid())
  product_id           String
  product_attribute_id String

  created_at DateTime @default(now())

  product   Product          @relation(fields: [product_id], references: [id], onDelete: Cascade)
  attribute ProductAttribute @relation(fields: [product_attribute_id], references: [id])

  @@unique([product_id, product_attribute_id])
  @@index([product_id])
  @@index([product_attribute_id])
  @@map("product_attribute_assignments")
}

// Junction: Opciones de atributo asignadas a combinaciones de producto
model ProductCombinationAttribute {
  id                          String @id @default(uuid())
  product_id                  String
  product_attribute_option_id String

  created_at DateTime @default(now())

  product          Product                @relation(fields: [product_id], references: [id], onDelete: Cascade)
  attribute_option ProductAttributeOption @relation(fields: [product_attribute_option_id], references: [id])

  @@unique([product_id, product_attribute_option_id])
  @@index([product_id])
  @@index([product_attribute_option_id])
  @@map("product_combination_attributes")
}

// ============================================
// WAREHOUSES & STORAGES
// ============================================

model Warehouse {
  id           String  @id @default(uuid())
  consecutive  String  @unique // ALM-0001
  name         String
  is_principal Boolean @default(false)

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  storages Storage[]
  users    WarehouseUser[]

  @@index([is_active])
  @@map("warehouses")
}

model Storage {
  id           String  @id @default(uuid())
  warehouse_id String
  consecutive  String  @unique // BOD-0001
  name         String
  is_principal Boolean @default(false)

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouse_id], references: [id])

  // Stock
  storage_stocks StorageStock[]

  // Movimientos
  movements ProductMovement[]

  // Transferencias entre bodegas (bodega por línea)
  storage_transfer_items StorageTransferItem[]

  // Transferencias entre productos (bodega por línea)
  product_transfer_items ProductTransferItem[]

  // Documentos
  document_items      DocumentItem[]
  document_receptions DocumentReception[]

  // POS
  cash_registers CashRegister[]

  @@index([warehouse_id])
  @@index([is_active])
  @@map("storages")
}

// Junction: Usuarios asignados a almacenes
model WarehouseUser {
  id             String @id @default(uuid())
  warehouse_id   String
  tenant_user_id String

  created_at DateTime @default(now())

  warehouse   Warehouse  @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)
  tenant_user TenantUser @relation(fields: [tenant_user_id], references: [id], onDelete: Cascade)

  @@unique([warehouse_id, tenant_user_id])
  @@index([warehouse_id])
  @@index([tenant_user_id])
  @@map("warehouse_users")
}

// Stock por bodega
model StorageStock {
  id         String  @id @default(uuid())
  product_id String
  storage_id String
  stock      Decimal @db.Decimal(15, 4)

  updated_at DateTime @updatedAt

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  storage Storage @relation(fields: [storage_id], references: [id], onDelete: Cascade)

  @@unique([product_id, storage_id])
  @@index([product_id])
  @@index([storage_id])
  @@map("storage_stocks")
}

// ============================================
// PRODUCT MOVEMENTS
// ============================================

model ProductMovement {
  id          String                   @id @default(uuid())
  consecutive String                   @unique // IM-0001
  product_id  String
  storage_id  String?
  type_key    String
  direction   ProductMovementDirection
  quantity    Decimal                  @db.Decimal(15, 4)
  date        DateTime                 @db.Date

  // Referencia al documento origen
  reference_id          String?
  reference_consecutive String?

  notes      String?
  created_at DateTime @default(now())

  product Product              @relation(fields: [product_id], references: [id])
  storage Storage?             @relation(fields: [storage_id], references: [id])
  type    ProductMovementType  @relation(fields: [type_key], references: [key])

  @@index([product_id])
  @@index([storage_id])
  @@index([type_key])
  @@index([date])
  @@index([direction])
  @@map("product_movements")
}

// ============================================
// STORAGE TRANSFERS
// ============================================

model StorageTransfer {
  id          String                @id @default(uuid())
  consecutive String                @unique // TI-0001
  reason      String?
  date        DateTime              @default(now()) @db.Date
  status      StorageTransferStatus @default(PENDING)

  // Trazabilidad
  transferred_by   String
  approved_by      String?
  approved_at      DateTime?
  rejected_by      String?
  rejected_at      DateTime?
  rejection_reason String?

  created_at DateTime @default(now())

  transferred_by_user TenantUser  @relation("TransferRequestedBy", fields: [transferred_by], references: [id])
  approved_by_user    TenantUser? @relation("TransferApprovedBy", fields: [approved_by], references: [id])
  rejected_by_user    TenantUser? @relation("TransferRejectedBy", fields: [rejected_by], references: [id])

  items StorageTransferItem[]

  @@index([status])
  @@index([transferred_by])
  @@index([created_at])
  @@map("storage_transfers")
}

model StorageTransferItem {
  id          String                   @id @default(uuid())
  transfer_id String
  product_id  String
  storage_id  String
  direction   ProductMovementDirection
  quantity    Decimal                  @db.Decimal(15, 4)

  created_at DateTime @default(now())

  transfer StorageTransfer @relation(fields: [transfer_id], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [product_id], references: [id])
  storage  Storage         @relation(fields: [storage_id], references: [id])

  @@index([transfer_id])
  @@index([product_id])
  @@index([storage_id])
  @@map("storage_transfer_items")
}

// Transferencia entre productos (padre ↔ combinaciones)
model ProductTransfer {
  id          String                 @id @default(uuid())
  consecutive String                 @unique // TP-0001
  reason      String
  date        DateTime               @default(now()) @db.Date
  status      ProductTransferStatus  @default(PENDING)

  // Trazabilidad
  requested_by     String
  approved_by      String?
  approved_at      DateTime?
  rejected_by      String?
  rejected_at      DateTime?
  rejection_reason String?

  created_at DateTime @default(now())

  requested_by_user TenantUser  @relation("ProductTransferRequestedBy", fields: [requested_by], references: [id])
  approved_by_user  TenantUser? @relation("ProductTransferApprovedBy", fields: [approved_by], references: [id])
  rejected_by_user  TenantUser? @relation("ProductTransferRejectedBy", fields: [rejected_by], references: [id])

  items ProductTransferItem[]

  @@index([status])
  @@index([requested_by])
  @@index([created_at])
  @@map("product_transfers")
}

// Líneas de transferencia entre productos (cada línea = un producto + dirección + bodega opcional)
model ProductTransferItem {
  id          String                   @id @default(uuid())
  transfer_id String
  product_id  String
  storage_id  String?
  direction   ProductMovementDirection // IN = entrada, OUT = salida
  quantity    Decimal                  @db.Decimal(15, 4)

  created_at DateTime @default(now())

  transfer ProductTransfer @relation(fields: [transfer_id], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [product_id], references: [id])
  storage  Storage?        @relation(fields: [storage_id], references: [id])

  @@index([transfer_id])
  @@index([product_id])
  @@index([storage_id])
  @@map("product_transfer_items")
}

// ============================================
// ACCOUNTING
// ============================================

model ChartOfAccount {
  code        String      @id
  name        String
  type        AccountType
  parent_code String?

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  parent   ChartOfAccount?  @relation("AccountHierarchy", fields: [parent_code], references: [code])
  children ChartOfAccount[] @relation("AccountHierarchy")

  third_parties_cxc ThirdParty[] @relation("ThirdPartyCxcAccount")
  third_parties_cxp ThirdParty[] @relation("ThirdPartyCxpAccount")

  accounting_configs AccountingConfig[] @relation("AccountConfig")

  // Payroll concepts
  payroll_concepts_debit       PayrollConcept[] @relation("PayrollConceptDebit")
  payroll_concepts_admin_debit PayrollConcept[] @relation("PayrollConceptAdminDebit")
  payroll_concepts_credit      PayrollConcept[] @relation("PayrollConceptCredit")

  // Journal entries, payments, prepayments
  journal_entry_items              JournalEntryItem[]
  payment_receipt_lines            PaymentReceiptLine[]
  prepayments                      Prepayment[]           @relation("PrepaymentAccount")
  prepayments_counterpart          Prepayment[]           @relation("PrepaymentCounterpartAccount")
  ar_ap                            ArAp[]

  // Fixed assets
  fixed_assets_asset        FixedAsset[] @relation("FixedAssetAccount")
  fixed_assets_depreciation FixedAsset[] @relation("FixedAssetDepreciationAccount")
  fixed_assets_expense      FixedAsset[] @relation("FixedAssetExpenseAccount")

  // Bank reconciliation
  bank_adjustment_types BankAdjustmentType[]

  // Expense categories
  expense_categories ExpenseCategory[]

  // Products
  products_asset   Product[] @relation("ProductAssetAccount")
  products_cogs    Product[] @relation("ProductCogsAccount")
  products_revenue Product[] @relation("ProductRevenueAccount")

  // Tax accounts
  taxes_sales_account             Tax[] @relation("TaxSalesAccount")
  taxes_purchases_account         Tax[] @relation("TaxPurchasesAccount")
  taxes_cost_account              Tax[] @relation("TaxCostAccount")
  taxes_withholding_sales         Tax[] @relation("WithholdingSalesAccount")
  taxes_withholding_purchases     Tax[] @relation("WithholdingPurchasesAccount")

  @@index([type])
  @@index([parent_code])
  @@map("chart_of_accounts")
}

model AccountingConfig {
  key          String   @id
  description  String
  account_code String?
  default      String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  account ChartOfAccount? @relation("AccountConfig", fields: [account_code], references: [code])

  @@map("accounting_configs")
}

model PayrollConcept {
