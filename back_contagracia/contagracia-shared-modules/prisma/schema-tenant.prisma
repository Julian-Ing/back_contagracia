  SIN_JUSTA_CAUSA       // Despido sin justa causa (Art. 64 CST - genera indemnización)
  EXPIRACION_PLAZO      // Expiración del plazo pactado (término fijo)
  OBRA_COMPLETADA       // Terminación de obra o labor contratada
