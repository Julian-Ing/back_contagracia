// ==================== PAYROLL SETTLEMENTS ====================

model PayrollSettlement {
  id                String                  @id @default(uuid())
  settlement_name   String
  settlement_number String?                 @unique
  settlement_type   PayrollSettlementType   @default(REGULAR)
  start_date        DateTime                @db.Date
  end_date          DateTime                @db.Date
  payment_date      DateTime?               @db.Date
  status            PayrollSettlementStatus @default(DRAFT)

  liquidate_prima              Boolean @default(false)
  liquidate_cesantias          Boolean @default(false)
  liquidate_cesantias_interest Boolean @default(false)
  liquidate_vacaciones         Boolean @default(false)

  total_employees              Int       @default(0)
  total_accrued                Decimal   @default(0) @db.Decimal(18, 4)
  total_deductions             Decimal   @default(0) @db.Decimal(18, 4)
  total_net_salary             Decimal   @default(0) @db.Decimal(18, 4)
  total_employer_contributions Decimal   @default(0) @db.Decimal(18, 4)
  total_provisions             Decimal   @default(0) @db.Decimal(18, 4)
  total_payroll_cost           Decimal   @default(0) @db.Decimal(18, 4)

  is_last_of_month Boolean @default(false)
  year             Int
  month            Int
  period_number    Int     @default(1)

  termination_reason String?

  notes          String?
  calculated_at  DateTime?
  approved_by_id String?
  approved_at    DateTime?
  created_by_id  String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  details PayrollSettlementDetail[]

  @@index([status])
  @@index([settlement_type])
  @@index([year, month])
  @@map("payroll_settlements")
}

model PayrollSettlementDetail {
  id                    String @id @default(uuid())
  payroll_settlement_id String
  third_party_id        String

  employee_name                String
  employee_document            String?
  employee_position            String?
  employee_base_salary         Decimal              @db.Decimal(18, 4)
  employee_salary_type         SalaryType           @default(ORDINARIO)
  employee_contract_type       String?
  employee_worker_type_code    String?
  employee_worker_subtype_code String?
  employee_is_administrative   Boolean              @default(false)
  employee_arl_rate            Decimal?             @db.Decimal(8, 4)
  employee_includes_transport  Boolean              @default(true)

  days_worked  Int      @default(30)
  hours_worked Decimal? @db.Decimal(8, 2)

  payroll_data Json @default("{}")
  input_data   Json @default("{}") // User-provided: bonuses, aids, other_income

  total_accrued                Decimal @default(0) @db.Decimal(18, 4)
  total_deductions             Decimal @default(0) @db.Decimal(18, 4)
  net_salary                   Decimal @default(0) @db.Decimal(18, 4)
  total_employer_contributions Decimal @default(0) @db.Decimal(18, 4)
  total_provisions             Decimal @default(0) @db.Decimal(18, 4)
  total_cost                   Decimal @default(0) @db.Decimal(18, 4)

  status        PayrollSettlementStatus @default(DRAFT)
  error_message String?
  notes         String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  payroll_settlement PayrollSettlement @relation(fields: [payroll_settlement_id], references: [id], onDelete: Cascade)
  third_party        ThirdParty        @relation("ThirdPartyPayrollDetails", fields: [third_party_id], references: [id])

  @@unique([payroll_settlement_id, third_party_id])
  @@index([payroll_settlement_id])
  @@index([third_party_id])
  @@map("payroll_settlement_details")
}
// ============================================
// PROPIEDAD HORIZONTAL (PH)
// ============================================

model PhCondominium {
  id              String   @id @default(uuid())
  company_id      String
  name            String
  nit             String?
  address         String?
  department_id   String?
  municipality_id String?
  phone           String?
  email           String?
  admin_company_id String?
  total_units     Int?     @default(0)
  price_per_m2    Decimal? @db.Decimal(15, 2)
  logo_url        String?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  created_by      String?

  towers          PhTower[]
  units           PhUnit[]
  common_areas    PhCommonArea[]
  billing_periods PhBillingPeriod[]
  unit_rentals    PhUnitRental[]
  billing_configs      PhBillingConfig[]
  insurance_policies   PhInsurancePolicy[]
  maintenance_plans    PhMaintenancePlan[]
  documents            PhDocument[]
  assemblies           PhAssembly[]
  pqrs                 PhPqrs[]
  comunicados          PhComunicado[]
