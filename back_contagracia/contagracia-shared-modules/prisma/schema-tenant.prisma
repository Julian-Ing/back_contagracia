}

enum PaymentType {
  CASH // Contado
  CREDIT // Crédito
}

enum SentToApi {
  NOT_SENT // No enviado
  SUCCESS // Éxito
  ERROR // Error
}

enum OrderType {
  PURCHASE // Compra
  EXPENSE // Gasto
  FIXED_ASSET // Activo fijo
}

enum AccountingPeriodStatus {
  OPEN // Abierto
  CLOSED // Cerrado
  REOPENED // Reabierto
}

enum AccountingPeriodActionType {
  OPEN // Apertura
  CLOSE // Cierre
  REOPEN // Reapertura
  ADJUST // Ajuste saldos iniciales
}

enum FixedAssetStatus {
  ACTIVE // Activo
  INACTIVE // Inactivo
  DISPOSED // Dado de baja
}

enum FixedAssetMovementType {
  CREATION // Alta/Creación del activo
  DEPRECIATION // Depreciación periódica
  ADJUSTMENT // Ajuste de valor
  ANNULMENT // Anulación del activo
  PURCHASE_RETURN // Devolución de compra
  DISPOSAL // Baja del activo
