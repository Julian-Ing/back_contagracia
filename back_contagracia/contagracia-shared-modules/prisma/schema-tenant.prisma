// ============================================
// TAX REPORTS (Reportes de Impuestos)
// ============================================

enum TaxReportTaxType {
  IVA
  INC
  RETEFUENTE
  RETEICA
  RETEIVA
}

enum TaxReportStatus {
  DRAFT
  CAUSED
  PAID
}

enum TaxPeriodType {
  MONTHLY
  BIMONTHLY
  QUARTERLY
  ANNUAL
}

enum TaxReportItemType {
  IVA_GENERATED
  IVA_DESCONTABLE
  IVA_FAVOR
  RETEIVA_FAVOR
  RETEIVA_PAYABLE
  RETEFUENTE_PAYABLE
  RETEICA_PAYABLE
  INC_GENERATED
}

enum PayrollSettlementType {
  REGULAR
  PRIMA
  CESANTIAS
  VACACIONES
  TERMINACION
}

enum PayrollSettlementStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
  CANCELLED
}

model TaxReport {
  id          String @id @default(uuid())
  consecutive String // IM-0001

  // Clasificación
  tax_type     TaxReportTaxType
  period_type  TaxPeriodType
  period_start DateTime         @db.Date
  period_end   DateTime         @db.Date
  year         Int

  // Montos
  iva_generated      Decimal @default(0) @db.Decimal(19, 4)
  iva_descontable    Decimal @default(0) @db.Decimal(19, 4)
  iva_favor          Decimal @default(0) @db.Decimal(19, 4)
  iva_reteiva_favor  Decimal @default(0) @db.Decimal(19, 4)
  inc_generated      Decimal @default(0) @db.Decimal(19, 4)
  reteiva_payable    Decimal @default(0) @db.Decimal(19, 4)
  retefuente_payable Decimal @default(0) @db.Decimal(19, 4)
  reteica_payable    Decimal @default(0) @db.Decimal(19, 4)
  net_amount         Decimal @default(0) @db.Decimal(19, 4)

  // Estado
  status        TaxReportStatus @default(DRAFT)
  emission_date DateTime        @db.Date
  due_date      DateTime        @db.Date

  // Integración ArAp (CxP creada al causar)
  ar_ap_id String?

  // Contabilización
  journal_entry_id String?

  // Auditoría
  created_by String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relaciones
  items TaxReportItem[]

  @@unique([tax_type, period_start, period_end])
  @@index([tax_type])
  @@index([year])
  @@index([status])
  @@index([ar_ap_id])
  @@map("tax_reports")
}

model TaxReportItem {
  id                    String            @id @default(uuid())
  tax_report_id         String
  journal_entry_item_id String
  type                  TaxReportItemType
  base_amount           Decimal           @db.Decimal(19, 4)
  tax_amount            Decimal           @db.Decimal(19, 4)
  created_at            DateTime          @default(now())

  // Relaciones
  tax_report TaxReport @relation(fields: [tax_report_id], references: [id], onDelete: Cascade)

  @@index([tax_report_id])
  @@index([journal_entry_item_id])
  @@map("tax_report_items")
}

// ============================================
// API LOG (Registro de envíos a DIAN/API)
