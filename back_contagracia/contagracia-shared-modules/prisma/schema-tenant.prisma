  applied_source             ArApSource?               @relation(fields: [applied_to_source_key], references: [key])
  company_payment_method     CompanyPaymentMethod?     @relation(fields: [company_payment_method_id], references: [id])
  cost_center                CostCenter?               @relation(fields: [cost_center_id], references: [id])
