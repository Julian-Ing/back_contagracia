model TaxObligationType {
  id                            String   @id @default(uuid())
  code                          String   @unique
  name                          String
  description                   String?
  category                      String   @default("nacional")
  periodicity                   String
  nit_digit_type                String   @default("last_1")
  applies_to_gran_contribuyente Boolean  @default(false)
