// ============================================
// DOCUMENTS (Unified: Invoices, Purchases, Expenses, Quotes, PO)
// ============================================

model Document {
  id String @id @default(uuid())

  // -- Tipo --
  doc_type DocType

  // -- Tercero --
  third_party_id   String?
  third_party_name String? // cache

  // -- Consecutivos --
  consecutive     String?
  external_number String? // número proveedor (compras/gastos)

  // -- Fechas --
  doc_date   DateTime  @db.Date
  due_date   DateTime? @db.Date
  issue_time DateTime? @db.Time(6)

  // -- Montos --
  subtotal            Decimal @default(0) @db.Decimal(19, 4)
  total_discounts     Decimal @default(0) @db.Decimal(19, 4)
  total_taxes         Decimal @default(0) @db.Decimal(19, 4)
  total_withholdings  Decimal @default(0) @db.Decimal(19, 4)
  net_amount          Decimal @default(0) @db.Decimal(19, 4) // subtotal + taxes - withholdings
  tax_details         Json? // resumen impuestos
  withholding_details Json? // resumen retenciones

  // -- Estado --
  status DocumentStatus @default(DRAFT)

  // -- Pago --
  payment_type      PaymentType?
  payment_method_id String? // FK a CompanyPaymentMethod (requerido por DIAN en crédito)

  // -- DIAN (Factura Electrónica) --
  type_operation_id String?
  resolution_id     String?
  cufe          String? // Código Único FE
  cude          String? // Código Único Doc Soporte
  qr_code_data  String?   @db.Text
  number_in_api String? // consecutivo API DIAN
  api_prefix    String?
  sent_to_api   SentToApi @default(NOT_SENT)
  api_response  Json?

  // -- Referencias NC/ND --
  referenced_doc_id             String?
  credit_note_discrepancy_id    BigInt?
  credit_note_discrepancy_sd_id BigInt?
  debit_note_discrepancy_id     BigInt?

  // -- Específicos Invoice --
  purchase_order_consecutive String?
  purchase_order_date        DateTime? @db.Date

  // -- Específicos Expense --
  category_id    String?
  deductible     Boolean @default(false)
  dian_cufe      String? // CUFE importado
  importado_dian Boolean @default(false)

  // -- Específicos Quote --
  valid_from          DateTime? @db.Date
  valid_to            DateTime? @db.Date
  accepted            Boolean?
  decision_token      String?
  decision_expires_at DateTime?
  decided_at          DateTime?
  accepted_invoice_id String?
  opportunity_id      String?
  crm_third_party_id  String?

  // -- Específicos Purchase Order --
  expected_delivery_date DateTime?  @db.Date
  order_type             OrderType?
  generated_doc_id       String?
  approved_by            String?
  approved_at            DateTime?
  cancelled_by           String?
  cancelled_at           DateTime?
  cancellation_reason    String?    @db.Text

  // -- Recurrente (solo para tipos *_RECURRENT) --
  recurrent_name      String?
  recurrent_period    String? // 1 month, 1 week, etc. (stored as string, interval not in Prisma)
  recurrent_is_active Boolean @default(false)

  // -- Otros --
  cost_center_id String? // FK a CostCenter (para CxC)
  notes          String? @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  payment_method             CompanyPaymentMethod?            @relation("DocumentPaymentMethod", fields: [payment_method_id], references: [id])
  cost_center                CostCenter?                      @relation("DocumentCostCenter", fields: [cost_center_id], references: [id])
  type_operation             TypeOperation?                   @relation(fields: [type_operation_id], references: [id])
  resolution                 Resolution?                      @relation(fields: [resolution_id], references: [id])
  category                   ExpenseCategory?                 @relation(fields: [category_id], references: [id])
  credit_note_discrepancy    CreditNoteDiscrepancyResponse?   @relation(fields: [credit_note_discrepancy_id], references: [id])
  credit_note_discrepancy_sd CreditNoteDiscrepancyResponseSd? @relation(fields: [credit_note_discrepancy_sd_id], references: [id])
  debit_note_discrepancy     DebitNoteDiscrepancyResponse?    @relation(fields: [debit_note_discrepancy_id], references: [id])

  // Self-relations
  referenced_doc   Document?  @relation("DocumentReference", fields: [referenced_doc_id], references: [id])
  referencing_docs Document[] @relation("DocumentReference")
  accepted_invoice Document?  @relation("QuoteToInvoice", fields: [accepted_invoice_id], references: [id])
  quotes           Document[] @relation("QuoteToInvoice")
  generated_doc    Document?  @relation("POToDoc", fields: [generated_doc_id], references: [id])
  purchase_orders  Document[] @relation("POToDoc")

  // CRM relations
  crm_opportunity CrmOpportunity? @relation("OpportunityDocuments", fields: [opportunity_id], references: [id])
  crm_third_party ThirdParty?     @relation("ContactDocuments", fields: [crm_third_party_id], references: [id])

  // Child tables
  items        DocumentItem[]
  withholdings DocumentWithholding[]
  attachments  DocumentAttachment[]
  aiu          DocumentAiu?
  receptions   DocumentReception[]

  // POS
  cash_movements CashMovement[]

  // Pagos del documento
  payments DocumentPayment[]

  @@index([doc_type])
  @@index([third_party_id])
  @@index([status])
  @@index([doc_date])
  @@index([category_id])
  @@index([referenced_doc_id])
  @@index([payment_method_id])
  @@index([cost_center_id])
  @@index([opportunity_id])
  @@index([crm_third_party_id])
  @@map("documents")
}

// ============================================
// DOCUMENT BANK PAYMENTS (Pagos Bancarios)
// ============================================

model DocumentPayment {
  id                        String  @id @default(uuid())
  document_id               String
  company_payment_method_id String
  bank_account_id           String?
  prepayment_id             String?
  cost_center_id            String?
  amount                    Decimal @db.Decimal(19, 4)

  created_at DateTime @default(now())

  document               Document             @relation(fields: [document_id], references: [id], onDelete: Cascade)
  company_payment_method CompanyPaymentMethod @relation(fields: [company_payment_method_id], references: [id])
  bank_account           BankAccount?         @relation(fields: [bank_account_id], references: [id])
  prepayment             Prepayment?          @relation(fields: [prepayment_id], references: [id])
  cost_center            CostCenter?          @relation(fields: [cost_center_id], references: [id])

  @@index([document_id])
  @@index([company_payment_method_id])
  @@index([bank_account_id])
  @@index([prepayment_id])
  @@index([cost_center_id])
  @@map("document_payments")
}

// ============================================
// DOCUMENT ITEMS (Líneas de Documentos)
// ============================================

model DocumentItem {
  id          String  @id @default(uuid())
  document_id String
  product_id  String?
  description String? @db.Text

  quantity          Decimal @db.Decimal(19, 4)
  quantity_received Decimal @default(0) @db.Decimal(19, 4) // solo PO
  unit_price        Decimal @db.Decimal(19, 4) // precio venta
  cost_price        Decimal @default(0) @db.Decimal(19, 4) // costo (compras)
  total_price       Decimal @db.Decimal(19, 4)

  is_discount_rate     Boolean @default(false)
  discount_rate        Decimal @default(0) @db.Decimal(5, 2)
  discount_value       Decimal @default(0) @db.Decimal(19, 4)
  discount_rate_value  Decimal @default(0) @db.Decimal(19, 4)
  discount_total_value Decimal @default(0) @db.Decimal(19, 4)

  tax_details Json?

  original_item_id String?
  storage_id       String?
  cost_center_id   String?
  fixed_asset_id   String?

  document       Document       @relation(fields: [document_id], references: [id], onDelete: Cascade)
  original_item  DocumentItem?  @relation("CreditNoteItem", fields: [original_item_id], references: [id])
  credited_items DocumentItem[] @relation("CreditNoteItem")
  storage        Storage?       @relation(fields: [storage_id], references: [id])
  cost_center    CostCenter?    @relation(fields: [cost_center_id], references: [id])

  taxes           DocumentItemTax[]
  reception_items DocumentReceptionItem[]

  @@index([document_id])
  @@index([product_id])
  @@index([storage_id])
  @@index([cost_center_id])
  @@index([original_item_id])
  @@map("document_items")
}

// ============================================
// DOCUMENT ITEM TAXES
// ============================================

model DocumentItemTax {
  id               String  @id @default(uuid())
  document_item_id String
  tax_id           String?

  tax_rate        Decimal  @db.Decimal(5, 2)
  tax_amount      Decimal  @db.Decimal(19, 4)
  per_unit_amount Decimal? @db.Decimal(19, 4)   // snapshot auditoría

  created_at DateTime @default(now())

  document_item DocumentItem @relation(fields: [document_item_id], references: [id], onDelete: Cascade)
  tax           Tax?         @relation(fields: [tax_id], references: [id])

  @@index([document_item_id])
  @@index([tax_id])
  @@map("document_item_taxes")
}

// ============================================
// DOCUMENT WITHHOLDINGS (Retenciones)
// ============================================

model DocumentWithholding {
  id             String  @id @default(uuid())
  document_id    String
  withholding_id String?
  cost_center_id String?

  rate   Decimal @db.Decimal(5, 2)
  amount Decimal @db.Decimal(19, 4)

  created_at DateTime @default(now())

  document    Document    @relation(fields: [document_id], references: [id], onDelete: Cascade)
  withholding Tax?        @relation(fields: [withholding_id], references: [id])
  cost_center CostCenter? @relation(fields: [cost_center_id], references: [id])

  @@index([document_id])
  @@index([withholding_id])
  @@index([cost_center_id])
  @@map("document_withholdings")
}

// ============================================
// DOCUMENT ATTACHMENTS
// ============================================

model DocumentAttachment {
  id          String @id @default(uuid())
  document_id String
  file_name   String
  file_path   String

  created_at DateTime @default(now())

  document Document @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@index([document_id])
  @@map("document_attachments")
}

// ============================================
// DOCUMENT AIU (Administración, Imprevistos, Utilidad)
// ============================================

model DocumentAiu {
  id          String @id @default(uuid())
  document_id String @unique

  administrative            Decimal @default(0) @db.Decimal(19, 4)
  administrative_percentage Decimal @default(0) @db.Decimal(5, 2)
  unexpected                Decimal @default(0) @db.Decimal(19, 4)
  unexpected_percentage     Decimal @default(0) @db.Decimal(5, 2)
  utility                   Decimal @default(0) @db.Decimal(19, 4)
  utility_percentage        Decimal @default(0) @db.Decimal(5, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  document Document @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@map("document_aius")
}

// ============================================
// DOCUMENT RECEPTIONS (Recepciones de OC)
// ============================================

model DocumentReception {
  id          String  @id @default(uuid())
  document_id String
  storage_id  String?
  consecutive String? // RC-0001

  status           Int       @default(0) @db.SmallInt // 0=borrador, 1=confirmada
  received_by      String?
  received_at      DateTime?
  confirmed_by     String?
  confirmed_at     DateTime?
  annulled_by      String?
  annulled_at      DateTime?
  annulment_reason String?   @db.Text
  notes            String?   @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  document Document                @relation(fields: [document_id], references: [id], onDelete: Cascade)
  storage  Storage?                @relation(fields: [storage_id], references: [id])
  items    DocumentReceptionItem[]

  @@index([document_id])
  @@index([storage_id])
  @@index([status])
  @@map("document_receptions")
}

model DocumentReceptionItem {
  id               String  @id @default(uuid())
  reception_id     String
  document_item_id String?
  product_id       String?
  description      String?

  quantity_received Decimal @db.Decimal(19, 4)
  storage_id        String?

  created_at DateTime @default(now())

  reception     DocumentReception @relation(fields: [reception_id], references: [id], onDelete: Cascade)
  document_item DocumentItem?     @relation(fields: [document_item_id], references: [id])

  @@index([reception_id])
  @@index([document_item_id])
  @@index([product_id])
  @@map("document_reception_items")
}

// ============================================
// FIXED ASSETS (Activos Fijos)
// ============================================

model FixedAssetCategory {
  id          String  @id @default(uuid())
  key         String  @unique // LAND, MACHINERY, COMPUTER_EQUIPMENT, etc.
  name        String // Terrenos, Maquinaria, Equipos de cómputo
  is_tangible Boolean @default(true)

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  fixed_assets FixedAsset[]

  @@map("fixed_asset_categories")
}

model FixedAsset {
  id          String @id @default(uuid())
  consecutive String @unique // AF-0001

  // -- Identificación --
  name        String
  description String?
  reference   String? // placa, serie, número de identificación
  category_id String?
  quantity    Int     @default(1)
  image_path  String?

  // -- Costos --
  acquisition_date DateTime @db.Date
  unit_cost        Decimal  @db.Decimal(19, 4)
  total_cost       Decimal  @db.Decimal(19, 4)

  // -- Depreciación --
  residual_value           Decimal?                     @db.Decimal(19, 4)
  calculation_basis        DepreciationCalculationBasis @default(USEFUL_LIFE)
  useful_life_months       Int?
  depreciation_rate        Decimal?                     @db.Decimal(5, 2) // % anual
  depreciation_start_date  DateTime?                    @db.Date
  last_depreciation_date   DateTime?                    @db.Date
  accumulated_depreciation Decimal                      @default(0) @db.Decimal(19, 4)
  net_book_value           Decimal                      @db.Decimal(19, 4)

  // -- Cuentas Contables --
  asset_account_code        String? // Cuenta del activo (15xxxx)
  depreciation_account_code String? // Cuenta depreciación acumulada (159xxx)
  expense_account_code      String? // Cuenta gasto depreciación (5260xx)

  // -- Estado --
  status FixedAssetStatus @default(ACTIVE)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  category FixedAssetCategory? @relation(fields: [category_id], references: [id])

  asset_account        ChartOfAccount? @relation("FixedAssetAccount", fields: [asset_account_code], references: [code])
  depreciation_account ChartOfAccount? @relation("FixedAssetDepreciationAccount", fields: [depreciation_account_code], references: [code])
  expense_account      ChartOfAccount? @relation("FixedAssetExpenseAccount", fields: [expense_account_code], references: [code])

  movements FixedAssetMovement[]

  @@index([category_id])
  @@index([status])
  @@index([acquisition_date])
  @@map("fixed_assets")
}

model FixedAssetMovement {
  id             String @id @default(uuid())
  fixed_asset_id String
  consecutive    String @unique // AFM-0001

  movement_type FixedAssetMovementType
  description   String?
  movement_date DateTime               @db.Date
  movement_time DateTime               @db.Time(6)

  // -- Cambios del Movimiento --
  quantity_change     Decimal  @default(0) @db.Decimal(19, 4)
  cost_change         Decimal  @default(0) @db.Decimal(19, 4)
  depreciation_change Decimal  @default(0) @db.Decimal(19, 4)
  book_value_change   Decimal? @db.Decimal(19, 4)

  // -- Snapshot ANTES --
  quantity_before     Decimal? @db.Decimal(19, 4)
  cost_before         Decimal? @db.Decimal(19, 4)
  depreciation_before Decimal? @db.Decimal(19, 4)
  book_value_before   Decimal? @db.Decimal(19, 4)

  // -- Snapshot DESPUÉS --
  quantity_after     Decimal? @db.Decimal(19, 4)
  cost_after         Decimal? @db.Decimal(19, 4)
  depreciation_after Decimal? @db.Decimal(19, 4)
  book_value_after   Decimal? @db.Decimal(19, 4)

  // -- Auditoría --
  journal_entry_id String?
  created_by       String?
  created_at       DateTime @default(now())

  // Relations
  fixed_asset     FixedAsset    @relation(fields: [fixed_asset_id], references: [id], onDelete: Cascade)
  journal_entry   JournalEntry? @relation(fields: [journal_entry_id], references: [id])
  created_by_user TenantUser?   @relation("FixedAssetMovementCreatedBy", fields: [created_by], references: [id])

  @@index([fixed_asset_id])
  @@index([movement_type])
  @@index([movement_date])
  @@index([journal_entry_id])
  @@map("fixed_asset_movements")
}

// ============================================
// BANK RECONCILIATION (Conciliación Bancaria)
// ============================================

model BankAdjustmentType {
  id           String               @id @default(uuid())
  name         String
  direction    TransactionDirection
  account_code String?
  is_active    Boolean              @default(true)
  created_at   DateTime             @default(now())

  account ChartOfAccount?          @relation(fields: [account_code], references: [code])
  items   BankReconciliationItem[]

  @@index([direction])
  @@map("bank_adjustment_types")
}

model BankReconciliation {
  id              String @id @default(uuid())
  bank_account_id String
  consecutive     String @unique // BC-0001

  reconciliation_date DateTime @db.Date
  period_start        DateTime @db.Date
  period_end          DateTime @db.Date

  // -- Saldos Extracto --
  extract_initial_balance Decimal @db.Decimal(19, 4)
  extract_final_balance   Decimal @db.Decimal(19, 4)

  // -- Saldos Sistema --
  system_initial_balance Decimal @db.Decimal(19, 4)
  system_final_balance   Decimal @db.Decimal(19, 4)

  difference Decimal                  @db.Decimal(19, 4)
  status     BankReconciliationStatus @default(PENDING)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  bank_account BankAccount              @relation(fields: [bank_account_id], references: [id])
  items        BankReconciliationItem[]

  @@index([bank_account_id])
  @@index([status])
  @@index([reconciliation_date])
  @@map("bank_reconciliations")
}

model BankReconciliationItem {
  id                String @id @default(uuid())
  reconciliation_id String

  source           BankReconciliationItemSource
  transaction_date DateTime                     @db.Date
  amount           Decimal                      @db.Decimal(19, 4)
  direction        TransactionDirection
  description      String?
  reference        String? // Referencia del extracto

  // -- Solo source=SYSTEM --
  journal_entry_item_id String?

  // -- Conciliación --
  status             BankReconciliationItemStatus @default(PENDING)
  matched_item_id    String?
  adjustment_type_id String?
  matched_at         DateTime?
  matched_by         String?
  notes              String?

  created_at DateTime @default(now())

  reconciliation     BankReconciliation       @relation(fields: [reconciliation_id], references: [id], onDelete: Cascade)
  journal_entry_item JournalEntryItem?        @relation(fields: [journal_entry_item_id], references: [id])
  matched_item       BankReconciliationItem?  @relation("MatchedItems", fields: [matched_item_id], references: [id])
  matched_items      BankReconciliationItem[] @relation("MatchedItems")
  adjustment_type    BankAdjustmentType?      @relation(fields: [adjustment_type_id], references: [id])
  matched_by_user    TenantUser?              @relation("BankReconciliationMatchedBy", fields: [matched_by], references: [id])

  @@index([reconciliation_id])
  @@index([source])
  @@index([status])
  @@index([journal_entry_item_id])
  @@index([matched_item_id])
  @@map("bank_reconciliation_items")
}

// ============================================
// CRM MODULE
// ============================================

// ---- Opportunity Stages (configurable per tenant) ----

model CrmOpportunityStage {
  id          String  @id @default(uuid())
  value       String? @unique // slug identifier (optional during migration, will be populated)
  name        String
  position    Int
  color       String  @default("#3B82F6")
  probability Int     @default(0) // 0-100

  is_won           Boolean @default(false)
  is_lost          Boolean @default(false)
  is_quoting_stage Boolean @default(false)
  is_initial_stage Boolean @default(false)

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  opportunities CrmOpportunity[]

  @@index([position])
  @@index([is_active])
  @@index([value])
  @@map("crm_opportunity_stages")
}

// ---- Contact Tags ----

model CrmContactTag {
  id        String  @id @default(uuid())
  name      String  @unique
  color     String  @default("#3B82F6")
  is_active Boolean @default(true)

  assignments CrmContactTagAssignment[]

  @@map("crm_contact_tags")
}

// ============================================
// POS - PUNTO DE VENTA
// ============================================

model CashRegister {
  id          String  @id @default(uuid())
  consecutive String
  name        String
  description String?

  // Cuenta de efectivo (REQUERIDA)
  cash_account_id String

  // Cuentas bancarias permitidas para cobrar [{bank_account_id, name}]
  allowed_bank_accounts Json? @db.JsonB

  // Referencias opcionales
  storage_id     String?
  cost_center_id String?
  resolution_id  String?

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  cash_account BankAccount   @relation("CashRegisterCashAccount", fields: [cash_account_id], references: [id])
  storage      Storage?      @relation(fields: [storage_id], references: [id])
  cost_center  CostCenter?   @relation(fields: [cost_center_id], references: [id])
  resolution   Resolution?   @relation(fields: [resolution_id], references: [id])
  sessions     CashSession[]

  @@index([cash_account_id])
  @@index([storage_id])
  @@index([cost_center_id])
  @@map("cash_registers")
}

model CrmCampaign {
  id              String          @id @default(uuid())
  name            String
  description     String?         @db.Text
  channel         CampaignChannel
  target_audience Json?

  start_date DateTime  @db.Date
  end_date   DateTime? @db.Date
  budget     Decimal?  @db.Decimal(19, 4)

  status CampaignStatus @default(ACTIVE)

  whatsapp_template_sid    String?
  whatsapp_template_params Json?

  created_by String?
  updated_by String?

  is_active  Boolean   @default(true)
  deleted_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  created_by_user TenantUser? @relation("CrmCampaignCreatedBy", fields: [created_by], references: [id])
  updated_by_user TenantUser? @relation("CrmCampaignUpdatedBy", fields: [updated_by], references: [id])

  leads             CrmLead[]
  activities        CrmActivity[]
  email_sends       EmailSend[]
  whatsapp_messages CrmWhatsappMessage[]
  lead_forms        CrmLeadForm[]

  @@index([channel])
  @@index([status])
  @@index([start_date])
  @@index([created_by])
  @@index([updated_by])
  @@index([is_active])
  @@map("crm_campaigns")
}

// ---- Leads ----

model CrmLead {
  id             String  @id @default(uuid())
  third_party_id String
  campaign_id    String?

  source LeadSource
  stage  LeadStage  @default(NEW)

  assigned_to String?

  converted_at DateTime?

  created_by String?
  updated_by String?

  is_active  Boolean   @default(true)
  deleted_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  third_party     ThirdParty   @relation("CrmLeadContact", fields: [third_party_id], references: [id], onDelete: Cascade)
  campaign        CrmCampaign? @relation(fields: [campaign_id], references: [id])
  assigned_user   TenantUser?  @relation("CrmLeadAssignedTo", fields: [assigned_to], references: [id])
  created_by_user TenantUser?  @relation("CrmLeadCreatedBy", fields: [created_by], references: [id])
  updated_by_user TenantUser?  @relation("CrmLeadUpdatedBy", fields: [updated_by], references: [id])

  activities        CrmActivity[]
  opportunities     CrmOpportunity[]
  whatsapp_messages CrmWhatsappMessage[]

  @@index([third_party_id])
  @@index([campaign_id])
  @@index([assigned_to])
  @@index([source])
  @@index([stage])
  @@index([created_by])
  @@index([updated_by])
  @@index([is_active])
  @@map("crm_leads")
}

// ---- Opportunities ----

model CrmOpportunity {
  id             String  @id @default(uuid())
  lead_id        String?
  third_party_id String?

  name           String
  expected_value Decimal   @db.Decimal(19, 4)
  stage_id       String
  probability    Decimal   @db.Decimal(5, 2)
  close_date     DateTime? @db.Date
  won_at         DateTime?
  lost_reason    String?   @db.Text

  assigned_to    String?
  cost_center_id String?

  history Json?

  created_by String?
  updated_by String?

  is_active  Boolean   @default(true)
  deleted_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  lead            CrmLead?            @relation(fields: [lead_id], references: [id])
  third_party     ThirdParty?         @relation("CrmOpportunityContact", fields: [third_party_id], references: [id])
  stage           CrmOpportunityStage @relation(fields: [stage_id], references: [id])
  assigned_user   TenantUser?         @relation("CrmOpportunityAssignedTo", fields: [assigned_to], references: [id])
  cost_center     CostCenter?         @relation("CrmOpportunityCostCenter", fields: [cost_center_id], references: [id])
  created_by_user TenantUser?         @relation("CrmOpportunityCreatedBy", fields: [created_by], references: [id])
  updated_by_user TenantUser?         @relation("CrmOpportunityUpdatedBy", fields: [updated_by], references: [id])

  activities        CrmActivity[]
  documents         Document[]           @relation("OpportunityDocuments")
  whatsapp_messages CrmWhatsappMessage[]

  @@index([lead_id])
  @@index([third_party_id])
  @@index([stage_id])
  @@index([assigned_to])
  @@index([cost_center_id])
  @@index([created_by])
  @@index([updated_by])
  @@index([is_active])
  @@index([close_date])
  @@map("crm_opportunities")
}

// ---- Activities ----

model CrmActivity {
  id             String  @id @default(uuid())
  third_party_id String?
  lead_id        String?
  opportunity_id String?
  user_id        String?
  campaign_id    String?

  type        CrmActivityType
  subject     String
  description String?         @db.Text

  status       CrmActivityStatus @default(PENDING)
  due_date     DateTime?
  completed_at DateTime?

  metadata Json?

  created_by String?

  is_active  Boolean   @default(true)
  deleted_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  third_party     ThirdParty?     @relation("CrmActivityContact", fields: [third_party_id], references: [id])
  lead            CrmLead?        @relation(fields: [lead_id], references: [id])
  opportunity     CrmOpportunity? @relation(fields: [opportunity_id], references: [id])
  user            TenantUser?     @relation("CrmActivityUser", fields: [user_id], references: [id])
  campaign        CrmCampaign?    @relation(fields: [campaign_id], references: [id])
  created_by_user TenantUser?     @relation("CrmActivityCreatedBy", fields: [created_by], references: [id])

  scheduled_reminders CrmScheduledReminder[]

  @@index([third_party_id])
  @@index([lead_id])
  @@index([opportunity_id])
  @@index([user_id])
  @@index([campaign_id])
  @@index([type])
  @@index([status])
  @@index([due_date])
  @@index([created_by])
  @@index([is_active])
  @@map("crm_activities")
}

// ---- Contact Tag Assignments (junction) ----

model CrmContactTagAssignment {
  id             String @id @default(uuid())
  third_party_id String
  tag_id         String

  created_at DateTime @default(now())

  third_party ThirdParty    @relation("CrmTagAssignmentContact", fields: [third_party_id], references: [id], onDelete: Cascade)
  tag         CrmContactTag @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@unique([third_party_id, tag_id])
  @@index([third_party_id])
  @@index([tag_id])
  @@map("crm_contact_tag_assignments")
}

// ---- Lead Forms ----

model CrmLeadForm {
  id          String  @id @default(uuid())
  name        String
  description String? @db.Text
  slug        String  @unique

  redirect_url String?
  campaign_id  String?

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

