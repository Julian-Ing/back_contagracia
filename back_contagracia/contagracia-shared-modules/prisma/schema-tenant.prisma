// This is your Prisma schema file for TENANT databases (per company)
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-tenant"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_TENANT_URL")
}

// ============================================
// ENUMS
// ============================================

enum ThirdPartyType {
  CLIENT // Cliente
  SUPPLIER // Proveedor
  EMPLOYEE // Empleado
  CONTACT // Contacto (solo desde CRM, no seleccionable en forms)
  EPS // Entidad Promotora de Salud
  PENSION_FUND // Fondo de Pensiones
  ARL // Administradora de Riesgos Laborales
  COMPENSATION_FUND // Caja de Compensación Familiar
  SEVERANCE_FUND // Fondo de Cesantías
  SENA // Servicio Nacional de Aprendizaje
  ICBF // Instituto Colombiano de Bienestar Familiar
  CO_OWNER // Copropietario (PH)
  TENANT // Arrendatario (PH)
  OTHER // Otro
}

