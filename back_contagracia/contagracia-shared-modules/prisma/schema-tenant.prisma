// ---- Automations ----

// Automatización de mensajes al cambiar etapa de oportunidad
model CrmOpportunityAutomation {
  id                   String  @id @default(uuid())
  name                 String? // Nombre descriptivo opcional
  trigger_stage_from   String? // null = cualquier etapa origen
  trigger_stage_to     String  // Etapa destino (requerido)
  action_type          String  // 'email' | 'whatsapp'
  email_template_id    String?
  whatsapp_template_id String?

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  email_template    EmailTemplate?       @relation(fields: [email_template_id], references: [id], onDelete: SetNull)
  whatsapp_template CrmWhatsappTemplate? @relation(fields: [whatsapp_template_id], references: [id], onDelete: SetNull)

  @@index([trigger_stage_from, trigger_stage_to])
  @@index([is_active])
  @@map("crm_opportunity_automations")
}

// Automatización para crear actividades al cambiar etapa
model CrmActivityAutomation {
  id                   String  @id @default(uuid())
  name                 String? // Nombre descriptivo opcional
  trigger_stage_from   String? // null = cualquier etapa origen
  trigger_stage_to     String  // Etapa destino (requerido)
  activity_type        String  // 'TASK' | 'CALL' | 'MEETING' | 'EMAIL' | 'NOTE'
  activity_subject     String
  activity_description String?
  days_offset          Int     @default(0) // Días después del trigger
  assigned_to_rule     String  @default("same_as_owner") // 'same_as_owner' | 'specific_user'
  assigned_to_user_id  String?

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@index([trigger_stage_from, trigger_stage_to])
  @@index([is_active])
  @@map("crm_activity_automations")
}

// Automatización al recibir envío de formulario
model CrmFormAutomation {
  id                      String  @id @default(uuid())
  form_id                 String  @unique // Una automatización por formulario
  create_lead             Boolean @default(true)
  lead_stage              String? // Etapa inicial del lead
  lead_source             String? // Source del lead
  create_opportunity      Boolean @default(false)
  opportunity_stage_id    String? // Etapa inicial de la oportunidad
  opportunity_value       Float?
  opportunity_probability Int?
  assignment_type         String  @default("none") // 'none' | 'round_robin' | 'specific_user'
  assigned_user_id        String?
  round_robin_users       Json?   // UUID[] - usuarios para rotación
  round_robin_index       Int     @default(0)
  send_notification       Boolean @default(false)
  auto_response_enabled   Boolean @default(false)
  auto_response_template_id String?

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  form                   CrmLeadForm       @relation(fields: [form_id], references: [id], onDelete: Cascade)
  auto_response_template EmailTemplate? @relation("FormAutoResponse", fields: [auto_response_template_id], references: [id], onDelete: SetNull)

  @@index([is_active])
  @@map("crm_form_automations")
}

// Automatización basada en eventos (cumpleaños, fechas, facturación)
model CrmEventAutomation {
  id                   String  @id @default(uuid())
  name                 String
  description          String?
  event_type           String  // 'birthday' | 'opportunity_won' | 'opportunity_lost' | 'year_end' | 'custom_date' | 'invoice_created' | 'invoice_paid' | 'quote_accepted' | 'quote_rejected'
  action_type          String  // 'email' | 'whatsapp' | 'both'
  email_template_id    String?
  whatsapp_template_id String?
  target_segments      Json?   // string[] - filtrar por tags de contacto
  delay_minutes        Int     @default(0)
  custom_time          String? // 'HH:mm' - hora de envío para eventos programados
  custom_date          DateTime? // Para event_type = 'custom_date'
  execution_count      Int     @default(0)
  last_executed_at     DateTime?
  applies_to_terceros  Boolean @default(false) // Para eventos de cartera/facturación

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  email_template    EmailTemplate?       @relation(fields: [email_template_id], references: [id], onDelete: SetNull)
  whatsapp_template CrmWhatsappTemplate? @relation(fields: [whatsapp_template_id], references: [id], onDelete: SetNull)

  @@index([event_type])
  @@index([is_active])
  @@map("crm_event_automations")
}

// Log de ejecución de automatizaciones
model CrmAutomationLog {
  id              String   @id @default(uuid())
  automation_type String   // 'opportunity' | 'activity' | 'form' | 'event' | 'reminder'
  automation_id   String
  trigger_data    Json     // Datos del evento que disparó la automatización
  action_data     Json     // Datos de la acción ejecutada
  status          String   // 'success' | 'failed' | 'skipped'
  error_message   String?
  executed_at     DateTime @default(now())

  @@index([automation_type, automation_id])
  @@index([status])
  @@index([executed_at])
  @@map("crm_automation_logs")
}

