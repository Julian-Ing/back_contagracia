model TypeWorker {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  employee_contracts EmployeeContract[] @relation("ContractWorkerType")

  @@map("type_workers")
}

model SubTypeWorker {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  employee_contracts EmployeeContract[] @relation("ContractWorkerSubtype")

  @@map("sub_type_workers")
