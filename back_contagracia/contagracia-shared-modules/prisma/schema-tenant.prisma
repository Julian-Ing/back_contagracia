  deposit_amount    Decimal? @db.Decimal(15, 2)
  requires_approval Boolean  @default(false)
  min_hours         Int?
  max_hours         Int?
  available_from    String?
  available_to      String?
  available_days    Int[]    @default([0, 1, 2, 3, 4, 5, 6])
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  created_by        String?

  condominium  PhCondominium            @relation(fields: [condominium_id], references: [id], onDelete: Cascade)
  reservations PhCommonAreaReservation[]

  @@index([condominium_id])
  @@map("ph_common_areas")
}

model PhCommonAreaReservation {
  id                  String    @id @default(uuid())
  common_area_id      String
  unit_id             String?
  tercero_id          String?
  reservation_date    DateTime
  start_time          String
  end_time            String
  status              String    @default("pending")
  total_fee           Decimal?  @db.Decimal(15, 2)
  deposit_paid        Boolean   @default(false)
  notes               String?
  cancelled_at        DateTime?
  cancelled_by        String?
  cancellation_reason String?
  confirmed_at        DateTime?
  confirmed_by        String?
  reminder_sent       Boolean   @default(false)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  created_by          String?

  common_area PhCommonArea @relation(fields: [common_area_id], references: [id], onDelete: Cascade)
  unit        PhUnit?      @relation(fields: [unit_id], references: [id])

  @@index([common_area_id])
  @@index([reservation_date])
  @@map("ph_common_area_reservations")
}

model PhUnitRental {
  id               String    @id @default(uuid())
  unit_id          String
  renter_unit_id   String
  condominium_id   String
  start_time       DateTime
  end_time         DateTime?
  total_minutes    Int?
  billable_minutes Int?
  amount           Decimal?  @db.Decimal(15, 2)
  fee_id           String?
  status           String    @default("active")
  notes            String?
  created_by       String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  unit        PhUnit        @relation("RentalUnit", fields: [unit_id], references: [id])
  renter_unit PhUnit        @relation("RenterUnit", fields: [renter_unit_id], references: [id])
  condominium PhCondominium @relation(fields: [condominium_id], references: [id])

  @@index([unit_id])
  @@index([renter_unit_id])
  @@index([condominium_id])
  @@map("ph_unit_rentals")
}

model PhBillingConfig {
  id                      String    @id @default(uuid())
  condominium_id          String
  config_type             String
  name                    String
  description             String?
  value_type              String    @default("percentage")
  value                   Decimal   @db.Decimal(15, 4)
  calculation_period      String?
  grace_days              Int       @default(0)
  is_compound             Boolean   @default(false)
  max_percentage          Decimal?  @db.Decimal(5, 2)
  max_amount              Decimal?  @db.Decimal(15, 2)
  effective_from          DateTime
  effective_to            DateTime?
  applies_to_all_concepts Boolean   @default(true)
  is_active               Boolean   @default(true)
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt
  created_by              String?

  condominium          PhCondominium            @relation(fields: [condominium_id], references: [id], onDelete: Cascade)
  concept_associations PhBillingConfigConcept[]

  @@index([condominium_id])
  @@index([config_type])
  @@map("ph_billing_configs")
}

model PhBillingConfigConcept {
  id                String   @id @default(uuid())
  billing_config_id String
  fee_concept_id    String
  created_at        DateTime @default(now())

  billing_config PhBillingConfig @relation(fields: [billing_config_id], references: [id], onDelete: Cascade)
  fee_concept    PhFeeConcept    @relation(fields: [fee_concept_id], references: [id], onDelete: Cascade)

  @@unique([billing_config_id, fee_concept_id])
  @@index([billing_config_id])
  @@index([fee_concept_id])
  @@map("ph_billing_config_concepts")
}

model PhInsurancePolicy {
  id                        String   @id @default(uuid())
  condominium_id            String
  insurance_third_party_id  String?  // FK al tercero (SUPPLIER) = aseguradora actual
  policy_number             String
  insurance_company         String   // nombre de referencia (fallback si no hay tercero)
  policy_type               String   // todo_riesgo, incendio, terremoto, responsabilidad_civil, otro
  coverage_amount           Decimal? @db.Decimal(15, 2)
  premium                   Decimal? @db.Decimal(15, 2)
  start_date                DateTime
  end_date                  DateTime
  renewal_date              DateTime?
  status                    String   @default("active") // active, expired, cancelled
  document_url              String?
  notes                     String?
  created_by                String?
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  condominium          PhCondominium  @relation(fields: [condominium_id], references: [id], onDelete: Cascade)
  insurance_third_party ThirdParty?   @relation("InsurancePolicyThirdParty", fields: [insurance_third_party_id], references: [id], onDelete: SetNull)
  insurers             PhInsurancePolicyInsurer[]

  @@index([condominium_id])
  @@index([insurance_third_party_id])
  @@index([status])
  @@index([end_date])
  @@map("ph_insurance_policies")
}

model PhInsurancePolicyInsurer {
  id             String    @id @default(uuid())
  policy_id      String
  third_party_id String
  role           String    @default("insurer") // insurer, broker, adjuster
  start_date     DateTime
  end_date       DateTime?
  notes          String?
  created_by     String?
  created_at     DateTime  @default(now())

  policy      PhInsurancePolicy @relation(fields: [policy_id], references: [id], onDelete: Cascade)
  third_party ThirdParty        @relation("InsurancePolicyInsurerThirdParty", fields: [third_party_id], references: [id], onDelete: Cascade)

  @@index([policy_id])
  @@index([third_party_id])
  @@map("ph_insurance_policy_insurers")
}

// ─── Planes de mantenimiento ───

model PhMaintenancePlan {
  id                        String    @id @default(uuid())
  condominium_id            String
  unit_id                   String?
  provider_third_party_id   String?
  name                      String
  description               String?
  category                  String    // ascensores, bombas, tanques, jardines, electrico, plomeria, pintura, impermeabilizacion, fumigacion, otro
  frequency                 String    // mensual, bimestral, trimestral, semestral, anual, unica
  estimated_cost            Decimal?  @db.Decimal(15, 2)
  last_maintenance_date     DateTime?
  next_maintenance_date     DateTime
  status                    String    @default("active") // active, paused, completed
  document_url              String?
  notes                     String?
  created_by                String?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt

  condominium    PhCondominium @relation(fields: [condominium_id], references: [id], onDelete: Cascade)
  unit           PhUnit?       @relation(fields: [unit_id], references: [id], onDelete: SetNull)
  provider       ThirdParty?   @relation("MaintenancePlanProvider", fields: [provider_third_party_id], references: [id], onDelete: SetNull)
  logs           PhMaintenanceLog[]

  @@index([condominium_id])
  @@index([unit_id])
  @@index([provider_third_party_id])
  @@index([status])
  @@index([next_maintenance_date])
  @@index([category])
  @@map("ph_maintenance_plans")
}

model PhMaintenanceLog {
  id                        String    @id @default(uuid())
  plan_id                   String
  unit_ids                  String[]  @default([])
  performed_date            DateTime
  performed_by              String?
  provider_third_party_id   String?
  actual_cost               Decimal?  @db.Decimal(15, 2)
  observations              String?
  document_url              String?
  created_by                String?
  created_at                DateTime  @default(now())

  plan           PhMaintenancePlan @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  provider       ThirdParty?       @relation("MaintenanceLogProvider", fields: [provider_third_party_id], references: [id], onDelete: SetNull)

  @@index([plan_id])
  @@index([provider_third_party_id])
  @@index([performed_date])
  @@map("ph_maintenance_logs")
}

// ============================================
// MEDIA (Archivos centralizados por tenant)
// ============================================

model Media {
  id            String   @id @default(uuid())
  original_name String
  file_name     String
  mime_type     String
  size          Int
  category      String
  visibility    String   @default("company")
  uploaded_by   String
  storage_path  String
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([category])
  @@index([uploaded_by])
  @@map("media")
  }
// ─── Espacio Documental ───

model PhDocumentCategory {
  id          String   @id @default(uuid())
  company_id  String
  name        String
  slug        String
  description String?
  color       String?
  icon        String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_by  String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  documents   PhDocument[]

  @@unique([company_id, slug])
  @@index([company_id])
  @@map("ph_document_categories")
}

model PhDocument {
  id               String    @id @default(uuid())
  condominium_id   String
  name             String
  description      String?
  category_id      String?
  file_url         String?   // URL from media-service (/api/media/{id})
  external_url     String?   // External link (Google Drive, OneDrive, etc.)
  file_name        String?   // Original filename
  file_size        Int?      // File size in bytes
  mime_type        String?
  uploaded_by      String?
  notes            String?
  status           String    @default("active") // active, archived
  created_by       String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  condominium PhCondominium       @relation(fields: [condominium_id], references: [id], onDelete: Cascade)
  category    PhDocumentCategory?  @relation(fields: [category_id], references: [id], onDelete: SetNull)

  @@index([condominium_id])
  @@index([category_id])
  @@index([status])
  @@map("ph_documents")
}

// ─── Asambleas ───────────────────────────────────────────────

model PhAssembly {
  id               String    @id @default(uuid())
  condominium_id   String
  title            String
  description      String?
  assembly_date    DateTime
  start_time       String    // "HH:MM"
  end_time         String?
  location         String?
  assembly_type    String    @default("ordinary") // ordinary, extraordinary
  quorum_required  Float?    // porcentaje mínimo (permite decimales como 38.5)
  quorum_reached   Boolean   @default(false)
  qr_code          String?   @unique // UUID token para el QR
  status           String    @default("scheduled") // scheduled, in_progress, completed, cancelled
  notes            String?
  created_by       String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  condominium PhCondominium        @relation(fields: [condominium_id], references: [id], onDelete: Cascade)
  attendances PhAssemblyAttendance[]
  votes       PhAssemblyVote[]

  @@index([condominium_id])
  @@index([status])
  @@index([assembly_date])
  @@map("ph_assemblies")
}

model PhAssemblyAttendance {
  id            String    @id @default(uuid())
  assembly_id   String
  unit_id       String?
  tercero_id    String?   // residente (referencia a terceros en master)
  resident_name String?   // nombre del residente (desnormalizado para reportes)
  unit_label    String?   // etiqueta de unidad (desnormalizado para reportes)
  delegate_name String?   // si asiste un delegado/apoderado
  method        String    @default("manual") // qr, manual
  checked_in_at DateTime  @default(now())
  notes         String?
  created_at    DateTime  @default(now())

  assembly PhAssembly @relation(fields: [assembly_id], references: [id], onDelete: Cascade)

  @@unique([assembly_id, tercero_id])
  @@index([assembly_id])
  @@map("ph_assembly_attendances")
}

model PhAssemblyVote {
  id          String    @id @default(uuid())
  assembly_id String
  title       String
  description String?
  vote_type   String    @default("yes_no") // yes_no, multiple_choice
  options     String?   // JSON array para multiple_choice: ["opcion1","opcion2",...]
  status      String    @default("pending") // pending, open, closed
  opened_at   DateTime?
  closed_at   DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  assembly PhAssembly             @relation(fields: [assembly_id], references: [id], onDelete: Cascade)
  results  PhAssemblyVoteResult[]

  @@index([assembly_id])
  @@map("ph_assembly_votes")
}

model PhAssemblyVoteResult {
  id              String   @id @default(uuid())
  vote_id         String
  tercero_id      String?
  unit_id         String?
  resident_name   String?  // desnormalizado
  unit_label      String?  // desnormalizado
  selected_option String   // "yes"/"no"/"abstain" o la opción elegida
  voted_at        DateTime @default(now())

  vote PhAssemblyVote @relation(fields: [vote_id], references: [id], onDelete: Cascade)

  @@unique([vote_id, tercero_id])
  @@index([vote_id])
  @@map("ph_assembly_vote_results")
}

// ─── PQRS (Peticiones, Quejas, Reclamos, Sugerencias) ───

model PhPqrs {
  id               String    @id @default(uuid())
  condominium_id   String
  unit_id          String?
  tercero_id       String?

  ticket_number    Int
  title            String
  description      String    @db.Text
  type             String    @default("petition")   // petition, complaint, claim, suggestion
  priority         String    @default("medium")     // low, medium, high, urgent
  status           String    @default("open")       // open, in_progress, resolved, closed

  contact_name     String?
  contact_email    String?
  contact_phone    String?

  resolved_at      DateTime?
  closed_at        DateTime?

  created_by       String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  condominium PhCondominium  @relation(fields: [condominium_id], references: [id], onDelete: Cascade)
  messages    PhPqrsMessage[]

  @@index([condominium_id])
  @@index([status])
  @@index([type])
  @@index([tercero_id])
  @@index([created_at])
  @@map("ph_pqrs")
}

model PhPqrsMessage {
  id            String    @id @default(uuid())
  pqrs_id       String
  content       String    @db.Text
  sender_type   String                        // 'admin' | 'resident'
  sender_id     String?
  sender_name   String?

  email_sent    Boolean   @default(false)
  email_sent_at DateTime?
  email_to      String?

  created_at    DateTime  @default(now())

  pqrs PhPqrs @relation(fields: [pqrs_id], references: [id], onDelete: Cascade)

  @@index([pqrs_id])
  @@map("ph_pqrs_messages")
}

model PhComunicado {
  id               String    @id @default(uuid())
  condominium_id   String
  title            String
  body             String    @db.Text
  target_roles     Json      // ["owner", "tenant"]
  status           String    @default("draft") // draft | sent
  sent_at          DateTime?
  total_recipients Int       @default(0)
  total_sent       Int       @default(0)
  total_failed     Int       @default(0)
  total_no_email   Int       @default(0)
  created_by       String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  condominium PhCondominium       @relation(fields: [condominium_id], references: [id], onDelete: Cascade)
  recipients  PhComunicadoRecipient[]

  @@index([condominium_id])
  @@index([status])
  @@index([created_at])
  @@map("ph_comunicados")
}

model PhComunicadoRecipient {
  id            String    @id @default(uuid())
  comunicado_id String
  tercero_id    String
  email         String?
  email_sent    Boolean   @default(false)
  email_error   String?
  created_at    DateTime  @default(now())

  comunicado PhComunicado @relation(fields: [comunicado_id], references: [id], onDelete: Cascade)

  @@index([comunicado_id])
  @@map("ph_comunicado_recipients")
}

// ─── Portería ────────────────────────────────────────────────────────────────

model PhAccessLog {
  id                  String    @id @default(uuid())
  condominium_id      String
  visit_type          String    // visitor | provider | resident | delivery
  visitor_name        String
  visitor_doc         String?
  visitor_company     String?
  destination_unit_id String?
  purpose             String?
  entry_at            DateTime  @default(now())
  exit_at             DateTime?
  notes               String?
  created_by          String
  created_at          DateTime  @default(now())

  condominium      PhCondominium @relation(fields: [condominium_id], references: [id], onDelete: Cascade)
  destination_unit PhUnit?       @relation(fields: [destination_unit_id], references: [id], onDelete: SetNull)

  @@index([condominium_id])
  @@index([entry_at])
  @@index([visit_type])
  @@map("ph_access_logs")
}

model PhPackage {
  id                String    @id @default(uuid())
  condominium_id    String
  unit_id           String
  tercero_id        String?
  description       String
  carrier           String?
  tracking_number   String?
  status            String    @default("pending") // pending | notified | delivered
  received_at       DateTime  @default(now())
  delivered_at      DateTime?
  notification_sent Boolean   @default(false)
  notes             String?
  created_by        String
  created_at        DateTime  @default(now())

  condominium PhCondominium @relation(fields: [condominium_id], references: [id], onDelete: Cascade)
  unit        PhUnit        @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  @@index([condominium_id])
  @@index([unit_id])
  @@index([status])
  @@map("ph_packages")
}

model PhMinutaEntry {
  id             String   @id @default(uuid())
  condominium_id String
  entry_type     String   // novedad | observacion | incidente | mantenimiento
  title          String
  body           String   @db.Text
  shift          String?  // mañana | tarde | noche
  created_by     String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  condominium PhCondominium @relation(fields: [condominium_id], references: [id], onDelete: Cascade)

  @@index([condominium_id])
  @@index([created_at])
  @@map("ph_minuta_entries")
}
