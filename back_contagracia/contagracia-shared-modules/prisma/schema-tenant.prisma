  journal_entry        JournalEntry?       @relation(fields: [journal_entry_id], references: [id])
  journal_entry_item   JournalEntryItem?   @relation(fields: [journal_entry_item_id], references: [id])

  @@index([ar_ap_id])
  @@index([payment_receipt_id])
  @@index([payment_receipt_line_id])
  @@index([journal_entry_id])
  @@index([journal_entry_item_id])
  @@index([date])
  @@map("payments")
}

// ============================================
// PREPAYMENTS (Anticipos)
