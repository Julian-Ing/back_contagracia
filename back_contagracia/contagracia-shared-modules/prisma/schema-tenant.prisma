// ============================================
// BANK MOVEMENT TYPES (Tipos de Movimientos Bancarios)
// ============================================

model BankMovementType {
  key         String @id
  description String

  movements BankMovement[]

  @@map("bank_movement_types")
}

model BankMovement {
  id                    String                @id @default(uuid())
  bank_account_id       String
  consecutive           String                // MB-0001
  transaction_date      DateTime              @db.Date
  amount                Decimal               @db.Decimal(19, 4)
  direction             BankMovementDirection @default(INCOME)
  type_key              String
  description           String?
  reference_id          String?  // UUID del documento origen (JournalEntry, Payment, etc.)
  reference_type        String?  // Tipo del documento: 'journal_entry', 'payment', etc.
  reference_consecutive String   @default("Movimiento desconocido")
  created_at            DateTime @default(now())

  bank_account BankAccount      @relation(fields: [bank_account_id], references: [id], onDelete: Cascade)
  type         BankMovementType @relation(fields: [type_key], references: [key])

  @@index([bank_account_id])
  @@index([transaction_date])
  @@index([type_key])
  @@map("bank_movements")
}

// ============================================
// AR/AP (Cuentas por Cobrar / Pagar)
// ============================================

model ArAp {
  id               String     @id @default(uuid())
  third_party_id   String
  type             ArApType
  source_key       String
  source_id        String
  source_number    String?
  consecutive      String? // CXC-0001 / CXP-0001
  date             DateTime   @db.Date
  due_date         DateTime?  @db.Date
  amount           Decimal    @db.Decimal(19, 4)
  paid             Decimal    @default(0) @db.Decimal(19, 4)
  balance          Decimal    @db.Decimal(19, 4)
  status           ArApStatus @default(PENDING)
  description      String?
  account_code     String?
  journal_entry_id String?
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt

  third_party ThirdParty      @relation(fields: [third_party_id], references: [id])
  source      ArApSource      @relation(fields: [source_key], references: [key])
  account     ChartOfAccount? @relation(fields: [account_code], references: [code])
