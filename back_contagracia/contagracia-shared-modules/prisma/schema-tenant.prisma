model PaymentReceiptLine {
  id                        String                 @id @default(uuid())
  payment_receipt_id        String
  kind                      PaymentReceiptLineKind
  account_code              String
  debit                     Decimal                @default(0) @db.Decimal(19, 4)
  credit                    Decimal                @default(0) @db.Decimal(19, 4)
  ref_id                    String?
  journal_entry_item_id     String?
  applied_to_source_key     String?
  applied_to_id             String?
  company_payment_method_id String?
  description               String?
  cost_center_id                String?
  cost_center_movement_type_key String?
  created_at                DateTime               @default(now())

