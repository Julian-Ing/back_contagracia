  company_payment_method_id String?
  journal_entry_id          String?
  cost_center_id            String?
  status                    PrepaymentStatus @default(ACTIVE)
  notes                     String?
  voided_at                 DateTime?
  voided_reason             String?
  voided_by                 String?
  refunded_at               DateTime?
  refunded_reason           String?
  refunded_by               String?
