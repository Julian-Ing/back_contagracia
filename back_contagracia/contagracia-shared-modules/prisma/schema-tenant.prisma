// ============================================
// MODULES & PERMISSIONS (Replicados del plan)
// ============================================

enum PayrollConceptType {
  ACCRUED // Devengados
  DEDUCTION // Deducciones
  PROVISION // Provisiones
  PARAFISCAL // Parafiscales
}

model Module {
  id          String   @id @default(uuid())
  module_key  String   @unique
  module_name String
  description String?
  icon        String?
  group       String   @default("Otros")
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  actions SystemAction[]

  @@map("modules")
}

model SystemAction {
  id             String    @id @default(uuid())
  module_id      String
  action_key     String    @unique
  action_name    String
  description    String?
  is_active      Boolean   @default(true)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  module Module @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@index([module_id])
  @@index([action_key])
  @@map("system_actions")
}

// ============================================
// ROLES (Por empresa - personalizables)
// ============================================

model Role {
  id          String   @id @default(uuid())
  role_key    String   @unique // "admin", "cajero", "supervisor_bodega", etc.
  role_name   String // "Administrador", "Cajero", "Supervisor de Bodega"
  description String?
  is_system   Boolean  @default(false) // true = no se puede eliminar (owner, admin)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  permissions RolePermission[]
  users       TenantUser[]

  @@map("roles")
}

// Permisos asignados a cada rol
model RolePermission {
  id         String   @id @default(uuid())
  role_id    String
  action_key String // "invoices.create", "inventory.adjust", etc.
  granted    Boolean  @default(true)
  created_at DateTime @default(now())

  // Relations
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, action_key])
  @@index([role_id])
  @@map("role_permissions")
}

// ============================================
// TENANT USERS & PERMISSIONS
// Empleados con acceso al sistema
// ============================================

model TenantUser {
  id            String  @id @default(uuid())
  email         String  @unique
  password_hash String
  full_name     String
  phone         String?

  // Rol del usuario en esta empresa
  role_id String

  // Vinculación a ThirdParty (opcional - si es empleado)
  third_party_id String? @unique

  // Estado
  is_active            Boolean @default(true)
  must_change_password Boolean @default(true)

  // Login tracking
  last_login_at DateTime?
  last_login_ip String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  role        Role                   @relation(fields: [role_id], references: [id])
  third_party ThirdParty?            @relation(fields: [third_party_id], references: [id])
  permissions TenantUserPermission[]

  // Warehouse relations
  warehouse_users     WarehouseUser[]
  transfers_requested StorageTransfer[] @relation("TransferRequestedBy")
  transfers_approved  StorageTransfer[] @relation("TransferApprovedBy")
  transfers_rejected  StorageTransfer[] @relation("TransferRejectedBy")

  // Transferencias entre productos
  product_transfers_requested ProductTransfer[] @relation("ProductTransferRequestedBy")
  product_transfers_approved  ProductTransfer[] @relation("ProductTransferApprovedBy")
  product_transfers_rejected  ProductTransfer[] @relation("ProductTransferRejectedBy")

  // Accounting period relations
  periods_closed         AccountingPeriod[]       @relation("PeriodClosedBy")
  periods_reopened       AccountingPeriod[]       @relation("PeriodReopenedBy")
  period_actions_created AccountingPeriodAction[] @relation("PeriodActionCreatedBy")

  // Fixed asset relations
  fixed_asset_movements_created FixedAssetMovement[] @relation("FixedAssetMovementCreatedBy")

  // Bank reconciliation relations
  bank_reconciliation_items_matched BankReconciliationItem[] @relation("BankReconciliationMatchedBy")

  // ThirdParty audit relations
  third_parties_created ThirdParty[] @relation("ThirdPartyCreatedBy")
  third_parties_updated ThirdParty[] @relation("ThirdPartyUpdatedBy")

  // HR Performance relations
  created_observations     EmployeeObservation[]   @relation("ObservationCreator")
  evaluations_as_evaluator PerformanceEvaluation[] @relation("EvaluationEvaluator")

  // CRM relations
  crm_leads_assigned         CrmLead[]            @relation("CrmLeadAssignedTo")
  crm_leads_created          CrmLead[]            @relation("CrmLeadCreatedBy")
  crm_leads_updated          CrmLead[]            @relation("CrmLeadUpdatedBy")
  crm_opportunities_assigned CrmOpportunity[]     @relation("CrmOpportunityAssignedTo")
  crm_opportunities_created  CrmOpportunity[]     @relation("CrmOpportunityCreatedBy")
  crm_opportunities_updated  CrmOpportunity[]     @relation("CrmOpportunityUpdatedBy")
  crm_campaigns_created      CrmCampaign[]        @relation("CrmCampaignCreatedBy")
  crm_campaigns_updated      CrmCampaign[]        @relation("CrmCampaignUpdatedBy")
  crm_activities             CrmActivity[]        @relation("CrmActivityUser")
  crm_activities_created     CrmActivity[]        @relation("CrmActivityCreatedBy")
  crm_whatsapp_messages      CrmWhatsappMessage[]        @relation("CrmWhatsappMessageUser")
  crm_whatsapp_conversations_assigned CrmWhatsappConversation[] @relation("CrmWhatsappConversationAssigned")
  // POS relations
  cash_sessions_opened       CashSession[]        @relation("CashSessionOpenedBy")
  cash_sessions_closed       CashSession[]        @relation("CashSessionClosedBy")

  // Shift management relations
  shift_schedules_published  ShiftSchedule[]      @relation("ShiftSchedulePublisher")
  shift_assignments_assigned ShiftAssignment[]    @relation("ShiftAssignmentAssigner")
  shift_swaps_approved       ShiftSwapRequest[]   @relation("ShiftSwapApprover")

  @@index([role_id])
  @@map("tenant_users")
}

// Permisos específicos del usuario (override del rol)
// Permite dar/quitar permisos específicos a un usuario
model TenantUserPermission {
  id             String  @id @default(uuid())
  tenant_user_id String
  action_key     String // "invoices.create", "inventory.adjust"
  granted        Boolean @default(true) // true=otorgar, false=denegar

  // Auditoría
  granted_by String? // user_id del admin que asignó
  reason     String? // motivo del permiso especial

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant_user TenantUser @relation(fields: [tenant_user_id], references: [id], onDelete: Cascade)

  @@unique([tenant_user_id, action_key])
  @@index([tenant_user_id])
  @@map("tenant_user_permissions")
}

// ============================================
// PARAMETRIC TABLES (Replicadas desde Master)
// Estas tablas se copian desde Master al crear el tenant
// Son READ-ONLY en el tenant (no se modifican)
// ============================================

// Geolocalización
model Department {
  id         String   @id @default(uuid())
  country_id String
  code       String   @unique
  name       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  municipalities Municipality[]
  third_parties  ThirdParty[]

  @@index([country_id])
  @@map("departments")
}

model Municipality {
  id            String   @id @default(uuid())
  department_id String
  code          String   @unique
  name          String
  dian_code     String?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  department    Department   @relation(fields: [department_id], references: [id])
  third_parties ThirdParty[]

  @@index([department_id])
  @@map("municipalities")
}

// Tipos DIAN
model TypeDocumentIdentification {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  third_parties ThirdParty[]

  @@map("type_document_identifications")
}

model TypeOrganization {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  third_parties ThirdParty[]

  @@map("type_organizations")
}

model TypeRegime {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  third_parties ThirdParty[]

  @@map("type_regimes")
}

model TypeLiability {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  category    String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  third_parties ThirdParty[]

  @@map("type_liabilities")
}

// Catálogos
model Bank {
  id         String   @id @default(uuid())
  code       String?  @unique
  name       String
  country    String   @default("CO")
  swift_code String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  bank_accounts BankAccount[]

  @@map("banks")
}

model PaymentMethod {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  third_parties           ThirdParty[]           @relation("ThirdPartyPaymentMethod")
  company_payment_methods CompanyPaymentMethod[]

  @@map("payment_methods")
}

// Métodos de pago personalizados del tenant
model CompanyPaymentMethod {
  id                String   @id @default(uuid())
  payment_method_id String // FK a PaymentMethod (código DIAN)
  consecutive       String?  @unique
  name              String // Nombre personalizado: "Nequi", "Daviplata", etc.
  description       String?
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  payment_method         PaymentMethod        @relation(fields: [payment_method_id], references: [id])
  documents         Document[]           @relation("DocumentPaymentMethod")
  document_payments DocumentPayment[]
  prepayments       Prepayment[]
  payment_receipt_lines  PaymentReceiptLine[]

  @@map("company_payment_methods")
}

model ProductUnit {
  id          String   @id @default(uuid())
  name        String
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  products Product[]

  @@map("product_units")
}

model Tax {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  rate              Decimal  @db.Decimal(8, 4)
  per_unit_amount   Decimal? @db.Decimal(19, 4)   // monto fijo por unidad (solo tax_type_id=10)
  tax_type_id Int      @default(1) // FK a TaxType (1=IVA, 5=ReteIVA, 6=ReteRenta, 7=ReteICA)
  description String?
  is_cost_tax Boolean  @default(false) // true = usa cuenta costo en vez de compras (solo IVA)
  is_system   Boolean  @default(false) // true = seedeado, no se puede eliminar
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  // Cuentas contables para impuestos
  tax_sales_account_code     String? // Cuenta IVA en ventas (ej: 240801)
  tax_purchases_account_code String? // Cuenta IVA en compras (ej: 240802)
  tax_cost_account_code      String? // Cuenta IVA en costos/gastos

  // Cuentas contables para retenciones
  withholding_sales_account_code     String? // Retención en ventas (a favor)
  withholding_purchases_account_code String? // Retención en compras (por pagar)

  tax_type              TaxType  @relation(fields: [tax_type_id], references: [id])
  products              Product[]
  document_item_taxes   DocumentItemTax[]
  document_withholdings DocumentWithholding[]

  tax_sales_account             ChartOfAccount? @relation("TaxSalesAccount", fields: [tax_sales_account_code], references: [code])
  tax_purchases_account         ChartOfAccount? @relation("TaxPurchasesAccount", fields: [tax_purchases_account_code], references: [code])
  tax_cost_account              ChartOfAccount? @relation("TaxCostAccount", fields: [tax_cost_account_code], references: [code])
  withholding_sales_account     ChartOfAccount? @relation("WithholdingSalesAccount", fields: [withholding_sales_account_code], references: [code])
  withholding_purchases_account ChartOfAccount? @relation("WithholdingPurchasesAccount", fields: [withholding_purchases_account_code], references: [code])

  @@map("taxes")
}

model TaxType {
  id          Int      @id // 1, 4, 5, 6, etc. (IDs fijos DIAN)
  code        String   @unique // "01" (IVA), "04" (INC), "05" (ReteIVA), etc.
  name        String // "IVA", "INC", "ReteIVA"
  description String? // "Impuesto sobre las Ventas"
  is_tax      Boolean  @default(true) // true = impuesto, false = retención
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  taxes Tax[]

  @@map("tax_types")
}

// Tipos de consecutivos (replicado desde master)
model ConsecutiveType {
  type            String  @id // invoice, purchase, journal_entry, etc.
  default_prefix  String  // FV, CO, JE, etc.
  description     String  // Factura de Venta, Compra, Asiento Contable, etc.
  table_name      String? // Nombre de la tabla Prisma: BankMovement, JournalEntry
  field_name      String  @default("consecutive") // Campo destino
  condition_field String? // Campo para condición (ej: type_key)
  condition_value String? // Valor de la condición (ej: sale_invoice)

  consecutive Consecutive?

  @@map("consecutive_types")
}

// Consecutivos por empresa (inicializado desde ConsecutiveType)
model Consecutive {
  type        String @id // FK a consecutive_types.type
  last_number Int    @default(0)
  prefix      String // Inicializado con default_prefix, editable por empresa
  padding     Int    @default(4) // Cantidad de dígitos (ej: 4 = 0001)

  consecutive_type ConsecutiveType @relation(fields: [type], references: [type])

  @@map("consecutives")
}

// Tipos de movimiento de inventario (replicado desde master)
model ProductMovementType {
  key  String @id // sale, purchase, transfer, adjustment, etc.
  name String // Venta, Compra, Transferencia, Ajuste, etc.

  movements ProductMovement[]

  @@map("product_movement_types")
}

// Paramétricas de Nómina (solo en Tenant)
model TypeContract {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  employee_contracts EmployeeContract[] @relation("ContractTypeContract")

  @@map("type_contracts")
}

model Event {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  @@map("events")
}

model TypeDocument {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  cufe_algorithm String?
  prefix         String?
  display_order  Int?
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())

  resolutions Resolution[]

  @@map("type_documents")
}

model TypeOperation {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  documents Document[]

  @@map("type_operations")
}

model Resolution {
  id                        String    @id @default(uuid())
  type_document_id          String
  prefix                    String    @db.VarChar(10)
  resolution_number         String
  resolution_date           DateTime  @db.Date
  technical_key             String?
  range_from                BigInt
  range_to                  BigInt
  last_external_consecutive Int?      @default(0)
  date_from                 DateTime? @db.Date
  date_to                   DateTime? @db.Date

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  type_document  TypeDocument   @relation(fields: [type_document_id], references: [id])
  documents      Document[]
  cash_registers CashRegister[]

  @@index([type_document_id])
  @@index([is_active])
  @@map("resolutions")
}

model TypeRejection {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  @@map("type_rejections")
}

model TypePayrollAdjustNote {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  @@map("type_payroll_adjust_notes")
}

model WorkerSubtypeRule {
  id                       String   @id @default(uuid())
  sub_type_worker_id       String   @unique
  health_employee_rate     Decimal? @db.Decimal(8, 4)
  health_employer_rate     Decimal? @db.Decimal(8, 4)
  pension_employee_rate    Decimal? @db.Decimal(8, 4)
  pension_employer_rate    Decimal? @db.Decimal(8, 4)
  health_employee_pays     Boolean  @default(true)
  pension_employee_pays    Boolean  @default(true)
  ccf_applies              Boolean  @default(true)
  icbf_applies             Boolean  @default(true)
  sena_applies             Boolean  @default(true)
  arl_applies              Boolean  @default(true)
  fsp_applies              Boolean  @default(true)
  fsp_special_rate         Decimal? @db.Decimal(8, 4)
  ibc_min_smmlv_percentage Decimal? @db.Decimal(8, 4)
  legal_notes              String?
  ui_display_name          String?
  ui_impacts               Json?
