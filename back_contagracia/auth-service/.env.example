# ==================================
# BASE DE DATOS
# ==================================
DATABASE_MASTER_URL="postgresql://USER:PASSWORD@HOST:PORT/contagracia_master?schema=public"

# PostgreSQL Admin (para crear tenant databases)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password

# DIAN API
DIAN_API_ENABLED=false
DIAN_API_URL=https://api.dian.gov.co

# ==================================
# JWT & SEGURIDAD
# ==================================
# IMPORTANTE: Cambiar esto en produccion por un secreto seguro de 256 bits minimo
JWT_SECRET="your-super-secret-key-change-in-production-256-bits-minimum"
JWT_EXPIRATION="1h"
REFRESH_TOKEN_EXPIRATION="7d"

# ==================================
# REDIS (Cache y Kill-Switch)
# ==================================
# Descomentar cuando se implemente Redis
# REDIS_URL="redis://localhost:6379"

# ==================================
# RABBITMQ (Mensajeria para emails)
# ==================================
# Descomentar cuando se implemente RabbitMQ
# RABBITMQ_URL="amqp://localhost:5672"

# ==================================
# SERVIDOR
# ==================================
PORT=3001
NODE_ENV="development"

# ==================================
# SEGURIDAD - RATE LIMITING
# ==================================
RATE_LIMIT_LOGIN=5
RATE_LIMIT_WINDOW=900000
SESSION_MAX_CONCURRENT=5
SESSION_INACTIVITY_DAYS=30
