# ==================================
# BASE DE DATOS MASTER
# ==================================
DATABASE_MASTER_URL="postgresql://USER:PASSWORD@HOST:PORT/contagracia_master?schema=public"

# ==================================
# BASE DE DATOS TENANT (configuracion por defecto)
# ==================================
TENANT_DB_HOST="localhost"
TENANT_DB_PORT="5432"
TENANT_DB_USER="postgres"
TENANT_DB_PASSWORD="your_password"

# ==================================
# JWT & SEGURIDAD
# ==================================
# IMPORTANTE: Debe ser el mismo JWT_SECRET que auth-service
JWT_SECRET="your-super-secret-key-change-in-production-256-bits-minimum"

# ==================================
# SERVIDOR
# ==================================
PORT=3003
NODE_ENV="development"

# ==================================
# PRISMA (para migraciones de tenant)
# ==================================
PRISMA_TENANT_SCHEMA_PATH="../contagracia-shared-modules/prisma/schema-tenant.prisma"
